{%- liquid
  assign c = section.settings.collection
  assign featured = section.settings.product
  if featured == blank and c != blank
    comment
      No product chosen: use the first in-stock product with photos from the catalogue collection.
    endcomment
    for p in c.products limit: 50
      if p.available and p.media.size > 0
        assign featured = p
        break
      endif
    endfor
    if featured == blank
      assign featured = c.products.first
    endif
  endif

  comment
    Facts line computed from the live catalogue: count, price range and size range.
  endcomment
  assign count = 0
  assign min_price = 0
  assign max_price = 0
  assign size_order = 'XXS,XS,S,M,L,XL,XXL,2XL,XXXL,3XL,4XL' | split: ','
  assign min_size_i = 99
  assign max_size_i = -1
  if c != blank
    assign count = c.products_count
    for p in c.products limit: 50
      if forloop.first or p.price_min < min_price
        assign min_price = p.price_min
      endif
      if p.price_max > max_price
        assign max_price = p.price_max
      endif
      for option in p.options_with_values
        assign on = option.name | downcase
        if on == 'size'
          for v in option.values
            for s in size_order
              if s == v.name
                assign idx = forloop.index0
                if idx < min_size_i
                  assign min_size_i = idx
                endif
                if idx > max_size_i
                  assign max_size_i = idx
                endif
              endif
            endfor
          endfor
        endif
      endfor
    endfor
  endif
  assign heading_lines = section.settings.heading | split: '|'
-%}
<section class="hero" aria-labelledby="HeroHeading-{{ section.id }}">
  <div class="page-width hero__grid">
    <div class="hero__copy">
      {%- if section.settings.kicker != blank -%}
        <p class="kicker mono">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h1 class="hero__heading display" id="HeroHeading-{{ section.id }}">
        {%- for line in heading_lines -%}
          <span class="hero__line">{{ line | strip | escape }}</span>
        {%- endfor -%}
      </h1>
      {% render 'ridge', class: 'hero__ridge' %}
      {%- if section.settings.text != blank -%}
        <p class="hero__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if count > 0 -%}
        <ul class="hero__facts spec-tags" role="list">
          <li class="tag">{{ 'general.pieces' | t: count: count }}</li>
          <li class="tag">{{ min_price | money }}–{{ max_price | money }}</li>
          {%- if max_size_i >= 0 -%}<li class="tag">Sizes {{ size_order[min_size_i] }}–{{ size_order[max_size_i] }}</li>{%- endif -%}
        </ul>
      {%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}
          </a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="button button--secondary" href="{{ section.settings.button2_link | default: '#fit' }}">{{ section.settings.button2_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if featured != blank -%}
      <div class="hero__explorer">
        <div class="hero__explorer-head">
          <p class="mono label">{{ section.settings.explorer_label | escape }}</p>
          <a class="hero__product-link link" href="{{ featured.url }}">{{ featured.title }} · {% render 'price', product: featured %}</a>
        </div>
        {% render 'garment-explorer', product: featured, explorer_id: section.id, own_swatches: true, priority: true, compact: true, sizes: '(min-width: 990px) 48vw, 100vw' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Opening screen",
  "class": "section-hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Peak Side · Reno, Nevada" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mountains|meet|everyday.", "info": "Use | to choose where lines break." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Clothes for days that start on a trail and end in town." },
    { "type": "collection", "id": "collection", "label": "Catalogue (for the facts line)", "info": "Count, price range and size range are calculated from this collection." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop the range" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button", "default": "Find your fit" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link" },
    { "type": "product", "id": "product", "label": "Product in the Garment Explorer", "info": "Leave empty to use the first in-stock product with photos." },
    { "type": "text", "id": "explorer_label", "label": "Explorer label", "default": "Switch colour · flip it · tap the numbers" }
  ],
  "presets": [{ "name": "Opening screen" }]
}
{% endschema %}

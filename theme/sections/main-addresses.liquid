{%- comment -%} Classic customer accounts: saved addresses. Shopify stores and validates them. {%- endcomment -%}
<section class="section account">
  <div class="page-width">
    <p><a class="link" href="{{ routes.account_url }}">{{ 'customer.order.back' | t }}</a></p>
    <h1 class="h1">{{ 'customer.addresses.title' | t }}</h1>
    {%- paginate customer.addresses by 10 -%}
      <ul class="address-list" role="list">
        {%- for address in customer.addresses -%}
          <li class="address-card">
            {%- if address == customer.default_address -%}<p class="mono label">{{ 'customer.addresses.default_label' | t }}</p>{%- endif -%}
            {{ address | format_address }}
            <details class="accordion">
              <summary class="accordion__summary"><span>{{ 'customer.addresses.edit' | t }}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
              <div class="accordion__content">
                {%- form 'customer_address', address, class: 'account__form' -%}
                  {% render 'form-errors', form: form %}
                  {%- capture prefix -%}EditAddress-{{ address.id }}{%- endcapture -%}
                  {% render 'address-fields', form: form, prefix: prefix %}
                  <button type="submit" class="button button--primary">{{ 'customer.addresses.update' | t }}</button>
                {%- endform -%}
              </div>
            </details>
            <form method="post" action="{{ address.url }}">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="link">{{ 'customer.addresses.delete' | t }}</button>
            </form>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
    <h2 class="h3">{{ 'customer.addresses.add' | t }}</h2>
    {%- form 'customer_address', customer.new_address, class: 'account__form' -%}
      {% render 'form-errors', form: form %}
      {% render 'address-fields', form: form, prefix: 'NewAddress' %}
      <button type="submit" class="button button--primary">{{ 'customer.addresses.add' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Customer addresses", "class": "section-main-addresses" }
{% endschema %}

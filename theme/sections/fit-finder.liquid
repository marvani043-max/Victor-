{%- liquid
  assign col = section.settings.collection
  assign fits = 'cropped,regular,boxy,oversized' | split: ','
  assign unassigned = 0
  if col != blank
    for p in col.products limit: 50
      if p.metafields.custom.fit_profile.value == blank
        assign unassigned = unassigned | plus: 1
      endif
    endfor
  endif
-%}
<section class="section fit-finder" id="fit" aria-labelledby="FitHeading-{{ section.id }}">
  <div class="page-width">
    <div class="section-head section-head--split">
      <div>
        <p class="kicker mono">{{ section.settings.kicker | escape }}</p>
        <h2 class="section-head__title h2" id="FitHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      <p class="section-head__text">{{ section.settings.text | escape }}</p>
    </div>

    <fit-finder class="fit-finder__body">
      <fieldset class="fit-finder__choices">
        <legend class="visually-hidden">{{ 'fit.scale_label' | t }}</legend>
        <div class="fit-track" aria-hidden="true"></div>
        {%- for f in fits -%}
          {%- capture f_key -%}fit.{{ f }}{%- endcapture -%}
          <label class="fit-choice">
            <input type="radio" name="fit-{{ section.id }}" value="{{ f }}" class="visually-hidden" {% if forloop.index == section.settings.default_index %}checked{% endif %}>
            <span class="fit-choice__tick" aria-hidden="true"></span>
            <span class="fit-choice__name">{{ f_key | t }}</span>
          </label>
        {%- endfor -%}
      </fieldset>

      <div class="fit-finder__panels">
        {%- for f in fits -%}
          {%- capture f_key -%}fit.{{ f }}{%- endcapture -%}
          {%- capture def_key -%}def_{{ f }}{%- endcapture -%}
          <div class="fit-panel" data-fit-panel="{{ f }}" {% if forloop.index == section.settings.default_index %}data-active{% endif %}>
            <div class="fit-panel__copy">
              <h3 class="fit-panel__title">{{ f_key | t }}</h3>
              <p>{{ section.settings[def_key] | escape }}</p>
            </div>
            <ul class="fit-panel__products" role="list">
              {%- if col != blank -%}
                {%- for p in col.products limit: 50 -%}
                  {%- if p.metafields.custom.fit_profile.value == f -%}
                    <li>
                      <a class="mini-card" href="{{ p.url }}">
                        <span class="mini-card__media">
                          {%- if p.featured_media -%}{%- capture mc_class -%}mini-card__img{% if p.featured_media.preview_image.aspect_ratio < 0.95 %} is-photo{% endif %}{%- endcapture -%}{% render 'image', image: p.featured_media.preview_image, alt: '', sizes: '120px', class: mc_class, widths: '240,360' %}{%- endif -%}
                        </span>
                        <span class="mini-card__body">
                          <span class="mini-card__title">{{ p.title }}</span>
                          <span class="mini-card__meta mono">{% render 'price', product: p %}{% unless p.available %} · {{ 'products.sold_out' | t }}{% endunless %}</span>
                          {%- if p.metafields.custom.fit_note.value != blank -%}
                            <span class="mini-card__note">{{ 'products.brand_fit_note' | t }}: {{ p.metafields.custom.fit_note.value }}</span>
                          {%- endif -%}
                        </span>
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endfor -%}
      </div>
    </fit-finder>

    <div class="fit-finder__foot">
      {%- if unassigned > 0 and settings.show_content_placeholders -%}
        {%- capture missing_text -%}{{ unassigned }} {% if unassigned == 1 %}piece has{% else %}pieces have{% endif %} no fit profile yet (custom.fit_profile).{%- endcapture -%}
        {% render 'content-placeholder', text: missing_text %}
      {%- endif -%}
      {%- if settings.fit_guide_page != blank -%}
        <a class="link" href="{{ settings.fit_guide_page.url }}">{{ section.settings.guide_link_label | escape }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fit finder",
  "class": "section-fit",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "03 — Fit, in plain words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four cuts. Pick yours." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every piece is one of four cuts. Choose one to see what it means and which pieces use it." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "default_index", "label": "Selected by default", "min": 1, "max": 4, "step": 1, "default": 4 },
    { "type": "textarea", "id": "def_cropped", "label": "Cropped: explanation", "default": "A shorter body that sits above the waist. For the off-shoulder crop tops, Peak Side recommends sizing down." },
    { "type": "textarea", "id": "def_regular", "label": "Regular: explanation", "default": "A classic shape that is neither fitted nor oversized." },
    { "type": "textarea", "id": "def_boxy", "label": "Boxy: explanation", "default": "Wider through the body with a squarer, straighter hang. For the boxy Summer Edition tee, Peak Side says stay true to size." },
    { "type": "textarea", "id": "def_oversized", "label": "Oversized: explanation", "default": "Cut big on purpose, with extra room through the body and sleeves." },
    { "type": "text", "id": "guide_link_label", "label": "Fit guide link", "default": "How to measure yourself" }
  ],
  "presets": [{ "name": "Fit finder" }]
}
{% endschema %}

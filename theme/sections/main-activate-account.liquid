<section class="section account">
  <div class="page-width page-width--narrow">
    <h1 class="h1">{{ 'customer.activate.title' | t }}</h1>
    <p class="muted">{{ 'customer.activate.text' | t }}</p>
    {%- form 'activate_customer_password', class: 'account__form' -%}
      {% render 'form-errors', form: form %}
      <div class="field"><label class="field__label" for="ActivatePassword">{{ 'customer.password' | t }}</label><input class="field__input" type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password"></div>
      <div class="field"><label class="field__label" for="ActivatePasswordConfirm">{{ 'customer.password_confirm' | t }}</label><input class="field__input" type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password"></div>
      <button type="submit" class="button button--primary">{{ 'customer.activate.submit' | t }}</button>
      <button type="submit" class="link" name="decline">{{ 'customer.activate.decline' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Activate account", "class": "section-main-activate" }
{% endschema %}

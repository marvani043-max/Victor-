<footer class="footer">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        <p class="wordmark wordmark--lg" aria-hidden="true">{{ shop.name | upcase }}</p>
        {% render 'ridge', class: 'footer__ridge' %}
        {%- if section.settings.blurb != blank -%}<p class="footer__blurb">{{ section.settings.blurb | escape }}</p>{%- endif -%}
        <ul class="footer__contact" role="list">
          {%- if settings.contact_email != blank -%}
            <li><a class="link link--inverse" href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
          {%- endif -%}
          {%- if settings.social_instagram != blank -%}
            <li>
              <a class="link link--inverse footer__ig" href="{{ settings.social_instagram }}" target="_blank" rel="noopener">
                {% render 'icon', name: 'instagram' %}{{ settings.social_instagram_handle | default: 'Instagram' }}<span class="visually-hidden"> ({{ 'general.new_window' | t }})</span>
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' and block.settings.menu.links.size > 0 -%}
          <nav class="footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
            <h2 class="footer__heading mono">{{ block.settings.heading | escape }}</h2>
            <ul role="list">
              {%- for link in block.settings.menu.links -%}
                <li><a class="link link--inverse" href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}

      <div class="footer__col footer__newsletter">
        <h2 class="footer__heading mono">{{ section.settings.newsletter_heading | escape }}</h2>
        <p class="footer__small">{{ section.settings.newsletter_text | escape }}</p>
        {%- form 'customer', id: 'NewsletterForm', class: 'newsletter', novalidate: 'novalidate', data-validate: '', data-track: 'newsletter_signup' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <div class="form-status form-status--success form-status--inverse" role="status" tabindex="-1" data-form-status>
              {% render 'icon', name: 'check' %}<p>{{ 'forms.newsletter_success' | t }}</p>
            </div>
          {%- else -%}
            {% render 'form-errors', form: form %}
            <div class="newsletter__row">
              <div class="field field--grow">
                <label class="field__label" for="NewsletterEmail">{{ 'forms.newsletter_label' | t }}</label>
                <input class="field__input field__input--inverse" id="NewsletterEmail" type="email" name="contact[email]" autocomplete="email" required aria-describedby="NewsletterEmail-error NewsletterConsent">
                <p class="field__error field__error--inverse" id="NewsletterEmail-error" hidden></p>
              </div>
              <button type="submit" class="button button--inverse" data-submit><span data-submit-label>{{ 'forms.newsletter_submit' | t }}</span></button>
            </div>
            <p class="footer__small" id="NewsletterConsent">{{ section.settings.consent_text | escape }}
              {%- for policy in shop.policies -%}{%- if policy.title contains 'rivacy' %} <a class="link link--inverse" href="{{ policy.url }}">{{ policy.title }}</a>.{% endif -%}{%- endfor -%}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <div class="footer__bottom">
      <p class="mono footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ 'general.based_in' | t: location: settings.brand_location }}</p>
      {%- if shop.policies.size > 0 -%}
        <ul class="footer__policies" role="list">
          {%- for policy in shop.policies -%}<li><a class="link link--inverse" href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if localization.available_countries.size > 1 -%}
        {%- form 'localization', id: 'FooterCountry', class: 'footer__country' -%}
          <label class="visually-hidden" for="FooterCountrySelect">{{ 'general.country_region' | t }}</label>
          <div class="select select--inverse">
            <select id="FooterCountrySelect" name="country_code" class="field__input field__input--inverse">
              {%- for c in localization.available_countries -%}
                <option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }} {{ c.currency.symbol }})</option>
              {%- endfor -%}
            </select>
            {% render 'icon', name: 'chevron' %}
          </div>
          <button type="submit" class="button button--inverse button--sm">{{ 'general.update_country' | t }}</button>
        {%- endform -%}
      {%- endif -%}
      <motion-toggle class="motion-toggle">
        <button type="button" class="motion-toggle__btn mono" aria-pressed="false" aria-describedby="MotionHint" data-motion-btn>
          <span class="motion-toggle__track" aria-hidden="true"><span></span></span>
          {{ 'general.motion_label' | t }}
        </button>
        <span class="visually-hidden" id="MotionHint">{{ 'general.motion_hint' | t }}</span>
      </motion-toggle>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "textarea", "id": "blurb", "label": "Short brand line", "default": "Hoodies, tees and crop tops for days that start on a trail and end in town." },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Drops & restocks" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "Get an email when something new drops or a sold-out piece comes back." },
    { "type": "textarea", "id": "consent_text", "label": "Consent text", "default": "By signing up you agree to receive marketing emails from Peak Side. Unsubscribe any time.", "info": "Marketing consent stays separate from contact and restock forms. Check this wording against your privacy policy." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}

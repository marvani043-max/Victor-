{%- paginate blog.articles by 12 -%}
<section class="section">
  <div class="page-width">
    <h1 class="h1">{{ blog.title | escape }}</h1>
    <ul class="article-list" role="list">
      {%- for article in blog.articles -%}
        <li class="article-card">
          {%- if article.image -%}<a href="{{ article.url }}" tabindex="-1" aria-hidden="true">{% render 'image', image: article.image, alt: '', sizes: '(min-width: 990px) 33vw, 100vw', class: 'article-card__img', widths: '360,540,720' %}</a>{%- endif -%}
          <h2 class="h3"><a class="link" href="{{ article.url }}">{{ article.title | escape }}</a></h2>
          <p class="mono muted">{{ article.published_at | date: '%d %b %Y' }}</p>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "class": "section-main-blog" }
{% endschema %}

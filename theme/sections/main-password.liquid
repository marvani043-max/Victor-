<section class="section password">
  <div class="page-width page-width--narrow password__inner">
    <p class="wordmark wordmark--lg" aria-hidden="true">{{ shop.name | upcase }}</p>
    <h1 class="h1">{{ 'password.title' | t }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'password__form' -%}
      {% render 'form-errors', form: form %}
      <div class="field">
        <label class="field__label" for="Password">{{ 'password.password' | t }}</label>
        <input class="field__input" type="password" name="password" id="Password" autocomplete="current-password">
      </div>
      <button class="button button--primary" type="submit">{{ 'password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Password", "class": "section-password" }
{% endschema %}

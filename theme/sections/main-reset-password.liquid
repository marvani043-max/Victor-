<section class="section account">
  <div class="page-width page-width--narrow">
    <h1 class="h1">{{ 'customer.reset.title' | t }}</h1>
    <p class="muted">{{ 'customer.reset.text' | t }}</p>
    {%- form 'reset_customer_password', class: 'account__form' -%}
      {% render 'form-errors', form: form %}
      <div class="field"><label class="field__label" for="ResetPassword">{{ 'customer.password' | t }}</label><input class="field__input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password"></div>
      <div class="field"><label class="field__label" for="ResetPasswordConfirm">{{ 'customer.password_confirm' | t }}</label><input class="field__input" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password"></div>
      <button type="submit" class="button button--primary">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Reset password", "class": "section-main-reset" }
{% endschema %}

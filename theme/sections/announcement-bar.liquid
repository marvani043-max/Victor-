{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="{{ 'general.announcement' | t }}" {{ section.shopify_attributes }}>
    <div class="page-width announcement__inner">
      {%- if section.settings.link != blank -%}
        <a class="announcement__text mono" href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
      {%- else -%}
        <p class="announcement__text mono">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Based in Reno, Nevada · Shipping worldwide", "info": "Keep to facts you can stand behind. No countdowns or invented urgency." },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}

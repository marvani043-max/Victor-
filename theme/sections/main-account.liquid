{%- comment -%} Classic customer accounts: order history and default address, from Shopify. {%- endcomment -%}
<section class="section account">
  <div class="page-width">
    <div class="section-head section-head--split">
      <h1 class="h1">{{ 'customer.account.title' | t }}</h1>
      <p class="account__links"><a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a></p>
    </div>
    <div class="account__grid">
      <div>
        <h2 class="h3">{{ 'customer.account.orders' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <div class="table-scroll" tabindex="0" role="region" aria-label="{{ 'customer.account.orders' | t }}">
              <table class="account-table">
                <thead><tr><th scope="col">{{ 'customer.order.number' | t }}</th><th scope="col">{{ 'customer.order.date' | t }}</th><th scope="col">{{ 'customer.order.payment' | t }}</th><th scope="col">{{ 'customer.order.fulfillment' | t }}</th><th scope="col">{{ 'customer.order.total' | t }}</th></tr></thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    <tr>
                      <th scope="row"><a class="link" href="{{ order.customer_url }}">{{ order.name }}</a></th>
                      <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                      <td>{{ order.financial_status_label }}</td>
                      <td>{{ order.fulfillment_status_label }}</td>
                      <td class="mono">{{ order.total_net_amount | money_with_currency }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
            {% render 'pagination', paginate: paginate %}
          {%- else -%}
            <p class="muted">{{ 'customer.account.no_orders' | t }}</p>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
      <div>
        <h2 class="h3">{{ 'customer.account.details' | t }}</h2>
        <p>{{ customer.name }}</p>
        {%- if customer.default_address -%}{{ customer.default_address | format_address }}{%- endif -%}
        <p><a class="link" href="{{ routes.account_addresses_url }}">{{ 'customer.account.addresses' | t: count: customer.addresses_count }}</a></p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Customer account", "class": "section-main-account" }
{% endschema %}

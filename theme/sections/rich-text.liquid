<section class="section rich-text">
  <div class="page-width page-width--narrow">
    {%- if section.settings.kicker != blank -%}<p class="kicker mono">{{ section.settings.kicker | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "class": "section-rich-text",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}

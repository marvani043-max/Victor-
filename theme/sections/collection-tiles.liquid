{%- comment -%}
  Shop by type. With no blocks added, it lists the store's own collections automatically
  (skipping "All", the legacy "Home page" collection and empty collections), so existing collections
  such as Cabin plaid, Tops and Bottoms appear without any setup. Add blocks to choose and order them by hand.
{%- endcomment -%}
{%- liquid
  assign shown = 0
  assign limit = section.settings.limit
-%}
{%- capture tiles -%}
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      {%- if col == blank or col.products_count == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      {% render 'collection-tile', col: col, title: block.settings.title, image: block.settings.image, attrs: block.shopify_attributes %}
    {%- endfor -%}
  {%- else -%}
    {%- for col in collections -%}
      {%- if col.handle == 'all' or col.handle == 'frontpage' or col.products_count == 0 -%}{%- continue -%}{%- endif -%}
      {%- if shown >= limit -%}{%- break -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      {% render 'collection-tile', col: col %}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if shown > 0 -%}
<section class="section tiles" aria-labelledby="TilesHeading-{{ section.id }}">
  <div class="page-width">
    <div class="section-head">
      <p class="kicker mono">{{ section.settings.kicker | escape }}</p>
      <h2 class="section-head__title h2" id="TilesHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>
    <ul class="tiles__list tiles__list--count-{{ shown | at_most: 6 }}" role="list">
      {{ tiles }}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Shop by type",
  "class": "section-tiles",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "01 — Shop by type" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What are you after?" },
    { "type": "range", "id": "limit", "label": "Collections to show automatically", "min": 2, "max": 6, "step": 1, "default": 5, "info": "Used when no collection blocks are added." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Shop by type" }]
}
{% endschema %}

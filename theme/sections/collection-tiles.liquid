<section class="section tiles" aria-labelledby="TilesHeading-{{ section.id }}">
  <div class="page-width">
    <div class="section-head">
      <p class="kicker mono">{{ section.settings.kicker | escape }}</p>
      <h2 class="section-head__title h2" id="TilesHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>
    <ul class="tiles__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- if col == blank -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign min_price = 0
          for p in col.products limit: 50
            if forloop.first or p.price_min < min_price
              assign min_price = p.price_min
            endif
          endfor
          assign tile_image = block.settings.image | default: col.featured_image | default: col.products.first.featured_media.preview_image
          assign min_money = min_price | money
        -%}
        <li class="tile" {{ block.shopify_attributes }}>
          <a class="tile__link" href="{{ col.url }}">
            <span class="tile__media">
              {%- if tile_image -%}
                {%- capture tile_class -%}tile__img{% if tile_image.aspect_ratio < 0.95 %} is-photo{% endif %}{%- endcapture -%}
                {% render 'image', image: tile_image, alt: '', sizes: '(min-width: 990px) 20vw, 50vw', class: tile_class, widths: '360,540,720' %}
              {%- endif -%}
            </span>
            <span class="tile__body">
              <span class="tile__title">{{ block.settings.title | default: col.title | escape }}</span>
              <span class="tile__meta mono">{{ 'general.pieces' | t: count: col.products_count }} · {{ 'general.from_price' | t: price: min_money }}</span>
            </span>
            {% render 'icon', name: 'arrow' %}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Shop by type",
  "class": "section-tiles",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "01 — Shop by type" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What are you after?" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Shop by type" }]
}
{% endschema %}

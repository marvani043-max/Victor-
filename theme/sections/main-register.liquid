{%- comment -%} Classic customer accounts: create an account. Marketing consent is a separate, unticked choice. {%- endcomment -%}
<section class="section account">
  <div class="page-width page-width--narrow">
    <h1 class="h1">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', class: 'account__form', id: 'RegisterForm', novalidate: 'novalidate', data-validate: '' -%}
      {% render 'form-errors', form: form %}
      <div class="field">
        <label class="field__label" for="RegisterFirstName">{{ 'customer.first_name' | t }}</label>
        <input class="field__input" type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterLastName">{{ 'customer.last_name' | t }}</label>
        <input class="field__input" type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterEmail">{{ 'forms.email' | t }} <span class="field__req">({{ 'forms.required' | t | downcase }})</span></label>
        <input class="field__input" type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" required aria-describedby="RegisterEmail-error">
        <p class="field__error" id="RegisterEmail-error" hidden></p>
      </div>
      <div class="field">
        <label class="field__label" for="RegisterPassword">{{ 'customer.password' | t }} <span class="field__req">({{ 'forms.required' | t | downcase }})</span></label>
        <input class="field__input" type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required aria-describedby="RegisterPassword-error">
        <p class="field__error" id="RegisterPassword-error" hidden></p>
      </div>
      <label class="checkbox"><input type="checkbox" name="customer[accepts_marketing]" value="true"> <span>{{ 'customer.register.marketing' | t }}</span></label>
      <button type="submit" class="button button--primary" data-submit><span data-submit-label>{{ 'customer.register.submit' | t }}</span></button>
      <p><a class="link" href="{{ routes.account_login_url }}">{{ 'customer.register.login' | t }}</a></p>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Customer register", "class": "section-main-register" }
{% endschema %}

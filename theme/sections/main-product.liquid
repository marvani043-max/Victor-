{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  capture color_pos_s
    render 'color-position', product: product
  endcapture
  assign color_pos = color_pos_s | plus: 0
  assign color_option = nil
  assign size_option = nil
  assign size_pos = 0
  for option in product.options_with_values
    assign on = option.name | downcase | strip
    if option.position == color_pos
      assign color_option = option
    elsif on == 'size' or on == 'sizes'
      assign size_option = option
      assign size_pos = option.position
    endif
  endfor
  assign size_idx = size_pos | minus: 1
  assign color_idx = color_pos | minus: 1
  capture fit
    render 'fit-profile', product: product
  endcapture
  assign fit_note = product.metafields.custom.fit_note.value
  assign fit_guide = settings.fit_guide_page | default: pages['fit-guide']
  assign contact = settings.contact_page | default: pages.contact
  assign fabric = product.metafields.custom.fabric_care.value
  assign size_chart = product.metafields.custom.size_chart.value
-%}

<section class="product" data-section-id="{{ section.id }}">
  <div class="page-width">
    <nav class="breadcrumbs mono" aria-label="{{ 'general.breadcrumbs' | t }}">
      <a class="link" href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> <span aria-hidden="true">/</span>
      {%- if collection -%}
        <a class="link" href="{{ collection.url }}">{{ collection.title | escape }}</a> <span aria-hidden="true">/</span>
      {%- else -%}
        <a class="link" href="{{ routes.all_products_collection_url }}">Shop</a> <span aria-hidden="true">/</span>
      {%- endif -%}
      <span aria-current="page">{{ product.title | escape }}</span>
    </nav>

    <div class="product__grid">
      <div class="product__media">
        {% render 'garment-explorer', product: product, explorer_id: section.id, own_swatches: false, thumbs: true, priority: true, sizes: '(min-width: 990px) 56vw, 100vw' %}
      </div>

      <div class="product__info">
        <p class="kicker mono">{{ product.type }}{% if product.tags contains 'Summer Edition' %} · Summer Edition{% endif %}</p>
        <h1 class="product__title h1">{{ product.title | escape }}</h1>

        <div class="product__price-row">
          {% render 'price', product: product, variant: current_variant, class: 'price--lg' %}
          <p class="stock{% unless current_variant.available %} stock--out{% endunless %}" data-stock>
            {%- if current_variant.available -%}
              {% render 'icon', name: 'check' %}<span>{{ 'products.in_stock' | t }}</span>
            {%- else -%}
              {% render 'icon', name: 'info' %}<span>{{ 'products.sold_out' | t }}</span>
            {%- endif -%}
          </p>
        </div>
        <p class="muted product__tax">{{ 'products.tax_note' | t }}</p>

        {% render 'spec-tags', product: product, class: 'product__tags' %}

        <product-form class="product-form" data-section="{{ section.id }}">
          {%- form 'product', product, id: form_id, class: 'product-form__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

            {%- for option in product.options_with_values -%}
              {%- assign on = option.name | downcase -%}
              {%- if option.position == color_pos and color_option -%}
                <fieldset class="option option--color">
                  <legend class="option__legend mono">{{ option.name }}: <span class="option__value" data-option-value="{{ option.position }}">{{ option.selected_value }}</span></legend>
                  <div class="swatch-group__list">
                    {%- for value in option.values -%}
                      <label class="swatch-option swatch-option--lg">
                        <input type="radio" class="visually-hidden" name="options[{{ option.name | escape }}]" value="{{ value.name | escape }}"
                          data-option-position="{{ option.position }}" {% if value.name == option.selected_value %}checked{% endif %}>
                        <span class="swatch" style="{% render 'swatch-style', value: value, product: product, color_pos: color_pos %}" aria-hidden="true"></span>
                        <span class="swatch-option__name">{{ value.name }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- elsif option.position == size_pos and size_option -%}
                <fieldset class="option option--size">
                  <legend class="option__legend mono">{{ option.name }}: <span class="option__value" data-option-value="{{ option.position }}">{{ option.selected_value }}</span></legend>
                  <button type="button" class="link option__guide" data-size-guide-open aria-haspopup="dialog">{{ 'products.size_guide' | t }}</button>
                  <div class="size-grid">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign size_available = false
                        for v in product.variants
                          assign v_size = v.options[size_idx]
                          if v_size == value.name
                            if color_option
                              assign v_color = v.options[color_idx]
                              if v_color == color_option.selected_value and v.available
                                assign size_available = true
                              endif
                            elsif v.available
                              assign size_available = true
                            endif
                          endif
                        endfor
                      -%}
                      <label class="size-chip{% unless size_available %} is-unavailable{% endunless %}">
                        <input type="radio" class="visually-hidden" name="options[{{ option.name | escape }}]" value="{{ value.name | escape }}"
                          data-option-position="{{ option.position }}" {% if value.name == option.selected_value %}checked{% endif %}>
                        <span class="size-chip__name">{{ value.name }}</span>
                        <span class="size-chip__state" data-size-state>{% unless size_available %}{{ 'products.sold_out' | t }}{% endunless %}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                  {%- if fit_note != blank -%}
                    <p class="fit-note">{% render 'icon', name: 'info' %}<span><strong>{{ 'products.brand_fit_note' | t }}:</strong> {{ fit_note }}</span></p>
                  {%- endif -%}
                </fieldset>
              {%- elsif product.has_only_default_variant == false -%}
                <div class="field option">
                  <label class="field__label" for="Option-{{ section.id }}-{{ forloop.index }}">{{ option.name }}</label>
                  <div class="select">
                    <select id="Option-{{ section.id }}-{{ forloop.index }}" class="field__input" name="options[{{ option.name | escape }}]" data-option-position="{{ option.position }}">
                      {%- for value in option.values -%}<option value="{{ value.name | escape }}"{% if value.name == option.selected_value %} selected{% endif %}>{{ value.name }}</option>{%- endfor -%}
                    </select>
                    {% render 'icon', name: 'chevron' %}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}

            <div class="product-form__buy">
              <div class="qty qty--lg" data-qty>
                <button type="button" class="qty__btn" data-qty-minus aria-label="{{ 'products.decrease_quantity' | t }}">{% render 'icon', name: 'minus' %}</button>
                <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
                <input class="qty__input" id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric">
                <button type="button" class="qty__btn" data-qty-plus aria-label="{{ 'products.increase_quantity' | t }}">{% render 'icon', name: 'plus' %}</button>
              </div>
              <button type="submit" name="add" class="button button--primary button--full product-form__submit" data-add-button {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}>
                <span class="spinner" aria-hidden="true"></span>
                <span data-add-label>{% if current_variant.available %}{{ 'products.add_to_bag' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
              </button>
            </div>
            <div class="form-status form-status--error" role="alert" data-form-error hidden>
              {% render 'icon', name: 'error' %}<p data-form-error-text></p>
            </div>
          {%- endform -%}
          <script type="application/json" data-product-json>{{ product | json }}</script>
        </product-form>

        <div class="product__restock" data-restock {% if current_variant.available %}hidden{% endif %}>
          {%- capture restock_id -%}RestockForm-{{ section.id }}{%- endcapture -%}
          {% render 'restock-form', product: product, form_id: restock_id %}
        </div>

        <div class="product__fit">
          <h2 class="product__subhead mono">{{ 'products.fit_heading' | t }}</h2>
          {% render 'fit-scale', fit: fit %}
          {%- if fit_guide != blank and fit_guide.url -%}
            <a class="link" href="{{ fit_guide.url }}">{{ section.settings.fit_link_label | escape }} {% render 'icon', name: 'arrow' %}</a>
          {%- endif -%}
        </div>

        <div class="product__description">
          <h2 class="product__subhead mono">{{ 'products.description_heading' | t }}</h2>
          <div class="rte">{{ product.description }}</div>
        </div>

        <div class="product__accordions">
          <details class="accordion">
            <summary class="accordion__summary"><span>{{ 'products.fabric_heading' | t }}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
            <div class="accordion__content rte">
              {%- if fabric != blank -%}
                {{ fabric }}
              {%- else -%}
                {% render 'content-placeholder', text: 'Fibre content, garment weight, care instructions and country of origin (custom.fabric_care). US textile labelling rules require accurate fibre content and origin on product listings.' %}
                {%- unless settings.show_content_placeholders -%}<p>Check the garment's care label for fabric and care details.</p>{%- endunless -%}
              {%- endif -%}
            </div>
          </details>
          <details class="accordion">
            <summary class="accordion__summary"><span>{{ 'products.shipping_heading' | t }}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
            <div class="accordion__content rte"><p>{{ settings.shipping_summary | escape }}</p></div>
          </details>
          <details class="accordion">
            <summary class="accordion__summary"><span>{{ 'products.returns_heading' | t }}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
            <div class="accordion__content rte">
              <p>{{ settings.returns_summary | escape }}</p>
              {%- if shop.refund_policy.url -%}<p><a class="link" href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></p>{%- endif -%}
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <dialog class="drawer size-guide" data-size-guide aria-labelledby="SizeGuideTitle-{{ section.id }}">
    <div class="drawer__inner">
      <div class="drawer__head">
        <h2 class="drawer__title" id="SizeGuideTitle-{{ section.id }}">{{ 'products.size_guide' | t }}</h2>
        <button type="button" class="icon-button" data-size-guide-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'general.close' | t }}</span></button>
      </div>
      <div class="drawer__body size-guide__body">
        <p class="size-guide__product">{{ product.title }}</p>
        <h3 class="product__subhead mono">{{ 'products.fit_heading' | t }}</h3>
        {% render 'fit-scale', fit: fit %}
        {%- if fit_note != blank -%}<p class="fit-note">{% render 'icon', name: 'info' %}<span><strong>{{ 'products.brand_fit_note' | t }}:</strong> {{ fit_note }}</span></p>{%- endif -%}
        {%- if size_option -%}
          <p><strong>Sizes:</strong> <span class="mono">{{ size_option.values | map: 'name' | join: ' · ' }}</span></p>
        {%- endif -%}
        {%- if size_chart != blank -%}
          <div class="rte size-chart">{{ size_chart }}</div>
        {%- else -%}
          {% render 'content-placeholder', text: 'Measured size chart for this piece (custom.size_chart).' %}
          <p>{{ section.settings.no_chart_text | escape }}</p>
        {%- endif -%}
        <ul class="size-guide__links" role="list">
          {%- if fit_guide != blank and fit_guide.url -%}<li><a class="link" href="{{ fit_guide.url }}">{{ section.settings.fit_link_label | escape }}</a></li>{%- endif -%}
          {%- if contact != blank and contact.url -%}<li><a class="link" href="{{ contact.url }}">{{ section.settings.ask_fit_label | escape }}</a></li>{%- endif -%}
        </ul>
      </div>
    </div>
  </dialog>

  <div class="sticky-buy" data-sticky-buy hidden>
    <div class="sticky-buy__info">
      <p class="sticky-buy__title">{{ product.title }}</p>
      <p class="sticky-buy__meta mono"><span data-sticky-price>{{ current_variant.price | money }}</span> · <span data-sticky-variant>{{ current_variant.title }}</span></p>
    </div>
    <button type="submit" form="{{ form_id }}" class="button button--primary" data-sticky-add {% unless current_variant.available %}disabled{% endunless %}>
      <span data-sticky-label>{% if current_variant.available %}{{ 'products.add_to_bag' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
    </button>
  </div>

  <script type="application/ld+json">{{ product | structured_data }}</script>
</section>

<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product",
  "class": "section-main-product",
  "settings": [
    { "type": "text", "id": "fit_link_label", "label": "Fit guide link", "default": "Full fit guide" },
    { "type": "text", "id": "ask_fit_label", "label": "Ask about fit link", "default": "Ask Peak Side about a measurement" },
    { "type": "textarea", "id": "no_chart_text", "label": "Text when there's no size chart yet", "default": "A measured chart isn't published yet. Compare the cut above with a top you own, or ask for a specific measurement." }
  ]
}
{% endschema %}

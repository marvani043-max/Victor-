<section class="section faq" aria-labelledby="FaqHeading-{{ section.id }}">
  <div class="page-width faq__grid">
    <div class="faq__intro">
      <p class="kicker mono">{{ section.settings.kicker | escape }}</p>
      <h2 class="h2" id="FaqHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- assign contact = settings.contact_page | default: pages.contact -%}
      {%- if contact != blank and contact.url -%}
        <a class="button button--secondary" href="{{ contact.url }}">{{ section.settings.contact_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">
            <span>{{ block.settings.question | escape }}</span>
            <span class="accordion__icon" aria-hidden="true"></span>
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "06 — Help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you buy" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "contact_label", "label": "Contact button", "default": "Ask a question" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}

{%- assign col = section.settings.collection -%}
<section class="section range" aria-labelledby="RangeHeading-{{ section.id }}">
  <div class="page-width">
    <div class="section-head section-head--split">
      <div>
        <p class="kicker mono">{{ section.settings.kicker | escape }}</p>
        <h2 class="section-head__title h2" id="RangeHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      <div class="section-head__aside">
        {%- if section.settings.text != blank -%}<p class="section-head__text">{{ section.settings.text | escape }}</p>{%- endif -%}
        {%- if col != blank -%}
          <a class="link" href="{{ col.url }}">{{ 'general.view_all' | t }} ({{ col.products_count }}) {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
      </div>
    </div>
    {%- if col != blank -%}
      <ul class="product-grid" role="list">
        {%- for product in col.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product range",
  "class": "section-range",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "02 — The range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every piece" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Sold-out pieces stay listed so you can request a restock." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 24, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "Product range" }]
}
{% endschema %}

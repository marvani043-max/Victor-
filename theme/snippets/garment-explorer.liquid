{%- comment -%}
  GARMENT EXPLORER: the signature interaction, driven entirely by the product's Shopify data.
  Colourway → photo (thumbnails, previous/next, front/back/detail/worn when the alt text says so) → numbered details.
  Params:
    product (required)
    explorer_id: unique id (section id)
    own_swatches: true to render colour controls inside the explorer (home page). On product pages the variant picker drives it.
    thumbs: true to show a thumbnail strip (product pages)
    priority: load the first image eagerly
    sizes: image sizes attribute
    compact: true for a shorter details list (labels only; notes stay available to screen readers)
  How photos map to colours (snippets/media-info.liquid): a colour name in the alt text, otherwise the variant whose image it is.
  Photos that match no colour show for every colour. Optional: product.metafields.custom.details (list of garment_detail
  metaobjects: label, note, view, x, y) adds numbered markers.
  Without JavaScript every photo is shown in a stacked gallery.
{%- endcomment -%}
{%- liquid
  capture color_pos_s
    render 'color-position', product: product
  endcapture
  assign color_pos = color_pos_s | plus: 0
  assign color_option = nil
  for option in product.options_with_values
    if option.position == color_pos
      assign color_option = option
    endif
  endfor
  assign current_color = ''
  if color_option
    assign current_color = color_option.selected_value | handle
  endif
  assign initial_media_id = product.selected_or_first_available_variant.featured_media.id
  assign details = product.metafields.custom.details.value
  assign stage_sizes = sizes | default: '(min-width: 990px) 55vw, 100vw'
  assign view_list = 'front,back,detail,worn' | split: ','

  comment
    Classify every media item once. Each entry: id|colour|view
  endcomment
  assign views_seen = ''
  assign view_count = 0
  assign slide_count = 0
  assign initial_found = false
  for media in product.media
    if media.media_type == 'image' or media.media_type == 'video' or media.media_type == 'external_video'
      capture info
        render 'media-info', media: media, product: product, color_pos: color_pos
      endcapture
      assign view_part = info | split: '|' | last
      unless views_seen contains view_part
        assign views_seen = views_seen | append: view_part | append: ','
        assign view_count = view_count | plus: 1
      endunless
      if media.id == initial_media_id
        assign initial_found = true
      endif
      assign slide_count = slide_count | plus: 1
    endif
  endfor
  assign has_views = false
  if view_count > 1
    assign has_views = true
  endif
-%}
<script src="{{ 'explorer.js' | asset_url }}" defer></script>
<garment-explorer
  class="explorer{% if compact %} explorer--compact{% endif %}{% unless has_views %} explorer--no-views{% endunless %}"
  id="Explorer-{{ explorer_id }}"
  data-color="{{ current_color }}"
  data-product="{{ product.handle }}"
  data-has-views="{{ has_views }}"
>
  <div class="explorer__stage">
    <div class="explorer__frame" data-stage>
      {%- assign shown_first = false -%}
      {%- assign slide_n = 0 -%}
      {%- for media in product.media -%}
        {%- unless media.media_type == 'image' or media.media_type == 'video' or media.media_type == 'external_video' -%}{%- continue -%}{%- endunless -%}
        {%- capture info -%}{%- render 'media-info', media: media, product: product, color_pos: color_pos -%}{%- endcapture -%}
        {%- liquid
          assign slide_n = slide_n | plus: 1
          assign parts = info | split: '|'
          assign m_color = parts[0]
          assign m_view = parts[1]
          assign is_initial = false
          if shown_first == false
            if initial_found
              if media.id == initial_media_id
                assign is_initial = true
              endif
            elsif m_color == current_color or m_color == blank or current_color == blank
              assign is_initial = true
            endif
            if is_initial
              assign shown_first = true
            endif
          endif
          assign eager = false
          if is_initial and priority
            assign eager = true
          endif
          assign has_markers = false
          if details != blank and media.media_type == 'image'
            if m_view == 'front' or m_view == 'back'
              assign has_markers = true
            endif
          endif
        -%}
        <figure
          class="explorer__slide"
          data-slide
          data-color="{{ m_color }}"
          data-view="{{ m_view }}"
          data-media-id="{{ media.id }}"
          data-media-type="{{ media.media_type }}"
          data-zoom-src="{{ media.preview_image | image_url: width: 1800 }}"
          {% if is_initial %}data-active{% endif %}
        >
          {%- case media.media_type -%}
            {%- when 'video' -%}
              {{ media | video_tag: image_size: '1100x', controls: true, muted: true, playsinline: true, loop: true, preload: 'none', class: 'explorer__video' }}
            {%- when 'external_video' -%}
              <div class="explorer__video explorer__video--external">{{ media | external_video_tag: loading: 'lazy' }}</div>
            {%- else -%}
              {%- if m_view == 'worn' or m_view == 'detail' -%}
                {% render 'image', image: media.preview_image, sizes: stage_sizes, class: 'explorer__img explorer__img--cover', priority: eager, alt: media.alt %}
              {%- else -%}
                <div class="explorer__fit">
                  <div class="explorer__canvas" style="--ratio: {{ media.preview_image.aspect_ratio | default: 1 }}">
                    {%- capture contain_class -%}explorer__img explorer__img--contain{% if media.preview_image.aspect_ratio < 0.95 %} is-photo{% endif %}{%- endcapture -%}
                    {% render 'image', image: media.preview_image, sizes: stage_sizes, class: contain_class, priority: eager, alt: media.alt %}
                    {%- if has_markers -%}
                      <div class="explorer__markers">
                        {%- for detail in details -%}
                          {%- liquid
                            assign d_view = detail.view.value | default: detail.view | default: 'front' | downcase
                            assign d_label = detail.label.value | default: detail.label
                            assign d_x = detail.x.value | default: detail.x | default: 50
                            assign d_y = detail.y.value | default: detail.y | default: 50
                          -%}
                          {%- if d_view == m_view -%}
                            <button
                              type="button"
                              class="marker"
                              data-marker="{{ forloop.index }}"
                              style="--x: {{ d_x }}%; --y: {{ d_y }}%;"
                              aria-label="{{ 'products.detail_marker' | t: number: forloop.index, label: d_label }}"
                              aria-controls="Detail-{{ explorer_id }}-{{ forloop.index }}"
                              aria-pressed="false"
                            >{{ forloop.index }}</button>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
          {%- endcase -%}
        </figure>
      {%- endfor -%}
      {%- if slide_count == 0 -%}
        <div class="explorer__empty">{{ product.title }}</div>
      {%- endif -%}
    </div>
    <p class="explorer__corner explorer__corner--view mono" aria-hidden="true" data-view-label>
      {%- if has_views -%}{{ 'products.view_front' | t }}{%- else -%}{{ 'products.image_counter' | t: number: 1, total: slide_count }}{%- endif -%}
    </p>
    {%- if color_option -%}
      <p class="explorer__corner explorer__corner--color mono" aria-hidden="true" data-color-label>{{ color_option.selected_value }}</p>
    {%- endif -%}
    {%- if slide_count > 1 -%}
      <button type="button" class="explorer__nav explorer__nav--prev icon-button" data-prev>
        {% render 'icon', name: 'arrow' %}<span class="visually-hidden">{{ 'products.previous_image' | t }}</span>
      </button>
      <button type="button" class="explorer__nav explorer__nav--next icon-button" data-next>
        {% render 'icon', name: 'arrow' %}<span class="visually-hidden">{{ 'products.next_image' | t }}</span>
      </button>
    {%- endif -%}
    {%- if slide_count > 0 -%}
      <button type="button" class="explorer__zoom icon-button" data-zoom aria-haspopup="dialog">
        {% render 'icon', name: 'zoom' %}<span class="visually-hidden">{{ 'products.zoom' | t }}</span>
      </button>
    {%- endif -%}
  </div>

  {%- if thumbs and slide_count > 1 -%}
    <div class="explorer__thumbs" role="group" aria-label="{{ 'products.images_label' | t }}" data-thumbs>
      {%- assign thumb_n = 0 -%}
      {%- for media in product.media -%}
        {%- unless media.media_type == 'image' or media.media_type == 'video' or media.media_type == 'external_video' -%}{%- continue -%}{%- endunless -%}
        {%- capture info -%}{%- render 'media-info', media: media, product: product, color_pos: color_pos -%}{%- endcapture -%}
        {%- assign thumb_n = thumb_n | plus: 1 -%}
        <button type="button" class="explorer__thumb" data-thumb="{{ media.id }}" data-color="{{ info | split: '|' | first }}" aria-pressed="false"
          aria-label="{{ 'products.show_image' | t: number: thumb_n, total: slide_count }}{% if media.alt != blank %}: {{ media.alt | escape }}{% endif %}">
          {% render 'image', image: media.preview_image, alt: '', sizes: '72px', class: 'explorer__thumb-img', widths: '120,180' %}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="explorer__controls">
    {%- if own_swatches and color_option and color_option.values.size > 1 -%}
      <fieldset class="swatch-group">
        <legend class="mono label">{{ color_option.name }}: <span data-color-name>{{ color_option.selected_value }}</span></legend>
        <div class="swatch-group__list">
          {%- for value in color_option.values -%}
            <label class="swatch-option">
              <input
                type="radio"
                class="visually-hidden"
                name="explorer-color-{{ explorer_id }}"
                value="{{ value.name | handle }}"
                data-color-name="{{ value.name | escape }}"
                {% if value.name == color_option.selected_value %}checked{% endif %}
              >
              <span class="swatch" style="{% render 'swatch-style', value: value, product: product, color_pos: color_pos %}" aria-hidden="true"></span>
              <span class="visually-hidden">{{ value.name }}</span>
            </label>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endif -%}

    {%- if has_views -%}
      <div class="view-switch" role="group" aria-label="{{ 'products.views_label' | t }}" data-views>
        {%- for v in view_list -%}
          {%- unless views_seen contains v -%}{%- continue -%}{%- endunless -%}
          {%- capture v_key -%}products.view_{{ v }}{%- endcapture -%}
          <button type="button" class="view-switch__btn mono" data-view-btn="{{ v }}" aria-pressed="false">{{ v_key | t }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if details != blank -%}
    <div class="explorer__details">
      <h2 class="mono label">{{ 'products.details_heading' | t }}</h2>
      <p class="explorer__hint">{{ 'products.details_hint' | t }}</p>
      <ol class="detail-list" role="list">
        {%- for detail in details -%}
          {%- liquid
            assign d_view = detail.view.value | default: detail.view | default: 'front' | downcase
            assign d_label = detail.label.value | default: detail.label
            assign d_note = detail.note.value | default: detail.note
          -%}
          <li class="detail-list__item" id="Detail-{{ explorer_id }}-{{ forloop.index }}" data-detail="{{ forloop.index }}" data-detail-view="{{ d_view }}">
            <button type="button" class="detail-list__btn" data-detail-btn="{{ forloop.index }}">
              <span class="detail-list__num" aria-hidden="true">{{ forloop.index }}</span>
              <span class="detail-list__text">
                <span class="detail-list__label">{{ d_label }}</span>
                {%- if d_note != blank -%}<span class="detail-list__note">{{ d_note }}</span>{%- endif -%}
              </span>
            </button>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  {%- endif -%}

  <dialog class="zoom-dialog" data-zoom-dialog aria-label="{{ 'products.zoom' | t }}">
    <button type="button" class="zoom-dialog__close icon-button" data-zoom-close>
      {% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'products.zoom_close' | t }}</span>
    </button>
    <div class="zoom-dialog__body" tabindex="0"><img alt="" width="1400" height="1400" data-zoom-img></div>
  </dialog>
</garment-explorer>

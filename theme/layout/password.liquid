<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ shop.name }}</title>
    <style>
      @font-face { font-family: 'Overpass'; src: url('{{ 'overpass-latin-wght-normal.woff2' | asset_url }}') format('woff2'); font-weight: 100 900; font-display: swap; }
      @font-face { font-family: 'Overpass Mono'; src: url('{{ 'overpass-mono-latin-400-normal.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-display: swap; }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>

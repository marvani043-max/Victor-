<div class="wrap py-16 sm:py-24">
  <a href="{{ routes.account_url }}" class="label link-u inline-flex items-center gap-2 text-granite">{% render 'icon', name: 'arrow-left' %} {{ 'customer.order.back' | t }}</a>
  <h1 class="display mt-6 text-[13vw] sm:text-7xl">{{ 'customer.addresses.title' | t }}</h1>

  {%- paginate customer.addresses by 10 -%}
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {%- for address in customer.addresses -%}
        <li class="border border-ink/15 p-5">
          {%- if address == customer.default_address -%}<p class="label mb-3 inline-block bg-ink px-2 py-1 text-bone">{{ 'customer.addresses.default' | t }}</p>{%- endif -%}
          <div class="text-[15px] leading-relaxed">{{ address | format_address }}</div>
          <details class="mt-4">
            <summary class="label cursor-pointer underline">{{ 'customer.addresses.edit' | t }}</summary>
            {%- form 'customer_address', address, class: 'mt-4 space-y-3' -%}
              {%- render 'address-fields', form: form, id: address.id -%}
              <button type="submit" class="btn-ink w-full">{{ 'customer.addresses.save' | t }}</button>
            {%- endform -%}
          </details>
          <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" class="mt-3" onsubmit="return confirm('{{ 'customer.addresses.delete_confirm' | t }}');">
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="label link-u text-granite">{{ 'customer.addresses.delete' | t }}</button>
          </form>
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}{%- render 'pagination', paginate: paginate -%}{%- endif -%}
  {%- endpaginate -%}

  <details class="mt-12 max-w-xl"{% if customer.addresses_count == 0 %} open{% endif %}>
    <summary class="btn-ink cursor-pointer list-none [&::-webkit-details-marker]:hidden">{{ 'customer.addresses.add' | t }}</summary>
    {%- form 'customer_address', customer.new_address, class: 'mt-6 space-y-3' -%}
      {%- render 'address-fields', form: form, id: 'new' -%}
      <button type="submit" class="btn-ink w-full">{{ 'customer.addresses.save' | t }}</button>
    {%- endform -%}
  </details>
</div>

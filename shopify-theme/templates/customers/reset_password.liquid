<div class="wrap py-16 sm:py-24">
  <h1 class="display text-[13vw] sm:text-7xl">{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password', class: 'mt-8 max-w-md space-y-4' -%}
    {%- if form.errors -%}<div class="form-message" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div><label for="ResetPassword" class="label">{{ 'customer.login.password' | t }}</label><input type="password" name="customer[password]" id="ResetPassword" class="field mt-2" autocomplete="new-password"></div>
    <div><label for="ResetConfirm" class="label">{{ 'customer.activate.password_confirm' | t }}</label><input type="password" name="customer[password_confirmation]" id="ResetConfirm" class="field mt-2" autocomplete="new-password"></div>
    <button type="submit" class="btn-ink w-full">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</div>

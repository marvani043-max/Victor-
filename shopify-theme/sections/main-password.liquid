{%- assign s = section.settings -%}
<section class="relative min-h-screen overflow-hidden bg-ink text-bone" {{ section.shopify_attributes }}>
  {%- render 'image', image: s.image, fallback: s.fallback, alt: '', class: 'absolute inset-0 h-full w-full object-cover opacity-50', loading: 'eager' -%}
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/60 to-ink/30"></div>
  <ps-petals snow></ps-petals>
  <div class="wrap relative flex min-h-screen flex-col justify-between py-10" style="padding-top: max(2.5rem, env(safe-area-inset-top)); padding-bottom: max(2.5rem, env(safe-area-inset-bottom))">
    <div class="flex items-center gap-1">
      <span aria-hidden="true" class="mask-pks block h-8 w-11"></span>
      <span class="display text-[22px] leading-none">{{ shop.name }}</span>
    </div>

    <div class="max-w-3xl">
      <p class="label text-sakura">{{ s.eyebrow }}</p>
      <h1 class="display mt-4 text-[17vw] sm:text-[8rem] lg:text-[9.5rem]">{{ s.heading }}<br><span class="text-sakura">{{ s.heading_accent }}</span></h1>
      {%- if shop.password_message != blank -%}
        <p class="mt-6 max-w-lg text-[17px] leading-relaxed text-bone/85">{{ shop.password_message }}</p>
      {%- elsif s.text != blank -%}
        <p class="mt-6 max-w-lg text-[17px] leading-relaxed text-bone/85">{{ s.text }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'PasswordNewsletter', class: 'mt-8 max-w-lg' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
        {%- if form.posted_successfully? -%}
          <p class="form-message" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <div class="flex flex-col gap-3 sm:flex-row">
            <label for="PasswordNewsletterEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
            <input id="PasswordNewsletterEmail" type="email" name="contact[email]" class="field field-dark min-w-0 flex-1" placeholder="{{ 'newsletter.label' | t }}" autocomplete="email" required>
            <button type="submit" class="btn-bone shrink-0">{{ s.signup_label }}</button>
          </div>
          {%- if form.errors -%}<p class="form-message mt-3" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <details class="max-w-sm">
        <summary class="label cursor-pointer list-none underline [&::-webkit-details-marker]:hidden">{{ 'general.password_page.login_form_heading' | t }}</summary>
        {%- form 'storefront_password', class: 'mt-4' -%}
          <div class="flex gap-3">
            <label for="StorePassword" class="visually-hidden">{{ 'general.password_page.login_form_password_label' | t }}</label>
            <input id="StorePassword" type="password" name="password" class="field field-dark min-w-0 flex-1" placeholder="{{ 'general.password_page.login_form_password_label' | t }}" autocomplete="current-password">
            <button type="submit" class="btn-bone shrink-0">{{ 'general.password_page.login_password_button' | t }}</button>
          </div>
          {%- if form.errors -%}<p class="form-message mt-3" role="alert">{{ 'general.password_page.login_form_error' | t }}</p>{%- endif -%}
        {%- endform -%}
        <p class="mt-4 text-[13px] text-bone/60">{{ 'general.password_page.admin_link_html' | t }}</p>
      </details>
      <div class="flex gap-4">
        {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" class="label flex items-center gap-2">{% render 'icon', name: 'instagram', class: 'h-4 w-4' %} Instagram</a>{%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener noreferrer" class="label flex items-center gap-2">{% render 'icon', name: 'tiktok', class: 'h-4 w-4' %} TikTok</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "select", "id": "fallback", "label": "Bundled photo (used when no image is set)", "default": "tunnel-crew", "options": [{"value":"","label":"None"},{"value":"trail-falls-front","label":"Trail: waterfall, black tee"},{"value":"trail-falls-back","label":"Trail: waterfall, tee back"},{"value":"trail-falls-wide","label":"Trail: waterfall, wide"},{"value":"trail-falls-rock","label":"Trail: granite and falls"},{"value":"trail-falls-duo","label":"Trail: two at the falls"},{"value":"trail-overlook","label":"Trail: canyon overlook"},{"value":"trail-ridge","label":"Trail: boulder"},{"value":"trail-path","label":"Trail: forest path"},{"value":"tunnel-crew","label":"Tunnel: the crew"},{"value":"tunnel-pink-hoodie","label":"Tunnel: pink hoodie"},{"value":"tunnel-crop-duo-2","label":"Tunnel: crop top duo"},{"value":"tunnel-crop-sit","label":"Tunnel: sitting crew"},{"value":"tunnel-crop-white","label":"Tunnel: white crop top"},{"value":"tunnel-crop-white-2","label":"Tunnel: white crop top 2"},{"value":"tunnel-zip-black","label":"Tunnel: black zip hoodie"},{"value":"tunnel-zip-navy","label":"Tunnel: navy zip hoodie"},{"value":"tunnel-tee-black-back","label":"Tunnel: tee back print"},{"value":"night-boxy-trio","label":"Night: boxy tee trio"},{"value":"detail-graphic-black","label":"Detail: Summer Edition graphic"}] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Opening soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mountains meet" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (pink)", "default": "everyday." },
    { "type": "textarea", "id": "text", "label": "Text (used when no password message is set in Shopify)", "default": "Pre-orders open soon. Get the email the moment the store goes live." },
    { "type": "text", "id": "signup_label", "label": "Signup button label", "default": "Notify me" }
  ]
}
{% endschema %}

{%- liquid
  assign s = section.settings
  assign link = s.link | default: settings.social_instagram_link
  assign handle = s.handle | default: settings.social_instagram_handle
-%}
<section class="border-t border-ink/10 py-20 sm:py-28" aria-labelledby="Heading-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div>
        {%- if s.eyebrow != blank -%}<p class="label text-granite">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 id="Heading-{{ section.id }}" class="display mt-3 text-6xl sm:text-8xl">{{ handle }}</h2>
      </div>
      {%- if link != blank -%}
        <a href="{{ link }}" target="_blank" rel="noopener noreferrer" class="btn-ink self-start sm:self-auto">{% render 'icon', name: 'instagram', class: 'h-4 w-4' %} {{ s.button_label }} {% render 'icon', name: 'arrow-up-right' %}</a>
      {%- endif -%}
    </div>
    <div class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4">
      {%- for block in section.blocks -%}
        <a href="{{ link | default: '#' }}" target="_blank" rel="noopener noreferrer" class="group relative block aspect-square overflow-hidden bg-coal" data-reveal style="--delay: {{ forloop.index0 | times: 0.05 }}s" {{ block.shopify_attributes }}>
          {%- render 'image', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.alt, class: 'h-full w-full object-cover transition-transform duration-700 group-hover:scale-105', sizes: '(min-width: 768px) 25vw, 50vw' -%}
          <span class="absolute inset-0 grid place-items-center bg-ink/0 text-bone opacity-0 transition-all duration-500 group-hover:bg-ink/40 group-hover:opacity-100">{% render 'icon', name: 'instagram', class: 'h-7 w-7' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Instagram grid",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drops, restocks, the crew" },
    { "type": "text", "id": "handle", "label": "Handle", "info": "Defaults to the Instagram handle in theme settings." },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the Instagram link in theme settings." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Follow on Instagram" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "fallback", "label": "Bundled photo (used when no image is set)", "default": "tunnel-crop-sit", "options": [{"value":"","label":"None"},{"value":"trail-falls-front","label":"Trail: waterfall, black tee"},{"value":"trail-falls-back","label":"Trail: waterfall, tee back"},{"value":"trail-falls-wide","label":"Trail: waterfall, wide"},{"value":"trail-falls-rock","label":"Trail: granite and falls"},{"value":"trail-falls-duo","label":"Trail: two at the falls"},{"value":"trail-overlook","label":"Trail: canyon overlook"},{"value":"trail-ridge","label":"Trail: boulder"},{"value":"trail-path","label":"Trail: forest path"},{"value":"tunnel-crew","label":"Tunnel: the crew"},{"value":"tunnel-pink-hoodie","label":"Tunnel: pink hoodie"},{"value":"tunnel-crop-duo-2","label":"Tunnel: crop top duo"},{"value":"tunnel-crop-sit","label":"Tunnel: sitting crew"},{"value":"tunnel-crop-white","label":"Tunnel: white crop top"},{"value":"tunnel-crop-white-2","label":"Tunnel: white crop top 2"},{"value":"tunnel-zip-black","label":"Tunnel: black zip hoodie"},{"value":"tunnel-zip-black-2","label":"Tunnel: black zip hoodie 2"},{"value":"tunnel-tee-black-back","label":"Tunnel: tee back print"},{"value":"night-boxy-trio","label":"Night: boxy tee trio"},{"value":"detail-graphic-black","label":"Detail: Summer Edition graphic"}] },
        { "type": "text", "id": "alt", "label": "Image description (alt text)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram grid",
      "blocks": [
        { "type": "photo", "settings": { "fallback": "tunnel-crop-sit", "alt": "Friends in crop tops sitting in front of graffiti" } },
        { "type": "photo", "settings": { "fallback": "trail-path", "alt": "White Summer Edition tee on a forest trail by a waterfall" } },
        { "type": "photo", "settings": { "fallback": "night-boxy-trio", "alt": "Three friends showing off the boxy tee back print at night" } },
        { "type": "photo", "settings": { "fallback": "trail-falls-duo", "alt": "Two friends in Peak Side tees at the foot of a waterfall" } }
      ]
    }
  ]
}
{% endschema %}

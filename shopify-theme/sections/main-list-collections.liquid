<div class="wrap pb-28 pt-10 sm:pt-16" {{ section.shopify_attributes }}>
  <h1 class="display text-[17vw] sm:text-[8rem] lg:text-[10rem]">{{ section.settings.heading }}</h1>
  <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {%- for collection in collections -%}
      {%- if collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
      <li>
        <a href="{{ collection.url }}" class="group relative block aspect-[4/5] overflow-hidden bg-coal text-bone">
          {%- assign cover = collection.image | default: collection.products.first.featured_media.preview_image -%}
          {%- if cover -%}
            {{ cover | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw', class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-[1.4s] ease-out group-hover:scale-[1.06]', alt: collection.title, loading: 'lazy' }}
          {%- endif -%}
          <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-5 sm:p-6">
            <div>
              <p class="label text-bone/70">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
              <p class="display mt-2 text-5xl">{{ collection.title }}</p>
            </div>
            <span class="mb-1 grid h-10 w-10 shrink-0 place-items-center bg-bone text-ink transition-colors group-hover:bg-sakura">{% render 'icon', name: 'arrow' %}</span>
          </div>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }]
}
{% endschema %}

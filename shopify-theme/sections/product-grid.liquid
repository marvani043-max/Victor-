{%- liquid
  assign s = section.settings
  if s.collection != blank
    assign source = s.collection.products
    assign view_all = s.collection.url
  else
    assign source = collections.all.products
    assign view_all = routes.all_products_collection_url
  endif
  assign shown = 0
-%}
<section class="wrap pb-24 sm:pb-32" aria-labelledby="Heading-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="flex items-end justify-between gap-6 border-b border-ink pb-5" data-reveal>
    <h2 id="Heading-{{ section.id }}" class="display text-6xl sm:text-8xl">{{ s.heading }}</h2>
    {%- if s.view_all_label != blank -%}
      <a href="{{ view_all }}" class="label link-u mb-2 hidden items-center gap-2 sm:inline-flex">{{ s.view_all_label }} {% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
  </div>
  <ul class="mt-8 grid grid-cols-2 gap-x-3 gap-y-10 sm:gap-x-5 lg:grid-cols-4">
    {%- for product in source -%}
      {%- if shown >= s.limit -%}{%- break -%}{%- endif -%}
      {%- if s.collection == blank and s.only_tagged -%}
        {%- unless product.tags contains 'best-seller' -%}{%- continue -%}{%- endunless -%}
      {%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      <li data-reveal style="--delay: {{ forloop.index0 | times: 0.06 }}s">{% render 'product-card', product: product, show_best_seller: false %}</li>
    {%- endfor -%}
  </ul>
  {%- if s.view_all_label != blank -%}
    <a href="{{ view_all }}" class="btn-line mt-10 w-full sm:hidden">{{ s.view_all_label }} {% render 'icon', name: 'arrow' %}</a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product grid",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show products tagged best-seller." },
    { "type": "checkbox", "id": "only_tagged", "label": "Without a collection, only show products tagged best-seller", "default": true },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "Shop all" }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}

<article class="wrap py-16 sm:py-24" {{ section.shopify_attributes }}>
  <a href="{{ blog.url }}" class="label link-u inline-flex items-center gap-2 text-granite">{% render 'icon', name: 'arrow-left' %} {{ 'blogs.back' | t }}</a>
  <p class="label mt-8 text-granite">{{ article.published_at | date: format: 'date' }}</p>
  <h1 class="display mt-3 max-w-5xl text-[13vw] sm:text-7xl lg:text-[6rem]">{{ article.title }}</h1>
  {%- if article.image -%}
    <div class="relative mt-10 aspect-[16/9] overflow-hidden bg-stone">
      {{ article.image | image_url: width: 1800 | image_tag: widths: '720, 1080, 1440, 1800', sizes: '100vw', class: 'absolute inset-0 h-full w-full object-cover', alt: article.title, loading: 'eager' }}
    </div>
  {%- endif -%}
  <div class="rte mx-auto mt-12 max-w-3xl text-[17px] leading-relaxed text-ink/85">{{ article.content }}</div>
</article>

{% schema %}
{ "name": "Blog post", "tag": "section" }
{% endschema %}

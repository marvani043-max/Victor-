<div class="wrap flex min-h-[70vh] flex-col justify-center py-24" {{ section.shopify_attributes }}>
  <p class="label text-granite">404 — {{ section.settings.eyebrow }}</p>
  <h1 class="display mt-4 text-[20vw] sm:text-[10rem]">{{ section.settings.heading }}</h1>
  <p class="mt-4 max-w-md text-[17px] text-ink/75">{{ section.settings.text }}</p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a href="{{ routes.all_products_collection_url }}" class="btn-ink">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
    <a href="{{ routes.root_url }}" class="btn-line">{{ 'general.home' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Off trail" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wrong turn." },
    { "type": "text", "id": "text", "label": "Text", "default": "This page doesn't exist, or it moved. The shop is still right where you left it." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Back to the shop" }
  ]
}
{% endschema %}

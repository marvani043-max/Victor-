{%- liquid
  assign s = section.settings
  if s.collection != blank
    assign source = s.collection.products
  else
    assign source = collections.all.products
  endif
  assign sep = ''
  assign count = 0
-%}
{%- capture products_json -%}
  {%- for product in source limit: 50 -%}
    {%- liquid
      unless product.available
        continue
      endunless
      assign warmth = ''
      assign fit = ''
      assign places = ''
      for tag in product.tags
        assign t = tag | downcase | strip
        if t contains 'warmth:'
          assign warmth = t | remove: 'warmth:' | strip
        elsif t contains 'fit:'
          assign fit = t | remove: 'fit:' | strip
        elsif t contains 'place:'
          assign place = t | remove: 'place:' | strip
          if places == blank
            assign places = place
          else
            assign places = places | append: ',' | append: place
          endif
        endif
      endfor
      if warmth == blank or fit == blank
        continue
      endif
      capture spin
        render 'spin-images', product: product, width: 900
      endcapture
      assign parts = spin | strip | split: '|'
      if parts[0] == 'cut'
        assign img = parts[1]
        assign is_cut = true
      else
        assign img = product.featured_media.preview_image | image_url: width: 900
        assign is_cut = false
      endif
      assign price = product.price | money | strip_html
      assign place_list = places | split: ','
    -%}
    {{ sep }}{"name": {{ product.title | json }}, "price": {{ price | json }}, "href": {{ product.url | json }}, "img": {{ img | json }}, "cut": {{ is_cut }}, "warmth": {{ warmth | json }}, "fit": {{ fit | json }}, "places": {{ place_list | json }}, "bestSeller": {% if product.tags contains 'best-seller' %}true{% else %}false{% endif %}}
    {%- assign sep = ',' -%}
    {%- assign count = count | plus: 1 -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if count > 1 -%}
  {%- liquid
    if s.trail_image != blank
      assign trail_url = s.trail_image | image_url: width: 900
    else
      assign trail_url = 'ps-trail-falls-front.webp' | asset_url
    endif
    if s.tunnel_image != blank
      assign tunnel_url = s.tunnel_image | image_url: width: 900
    else
      assign tunnel_url = 'ps-tunnel-pink-hoodie.webp' | asset_url
    endif
  -%}
  <section class="py-20 sm:py-28" aria-labelledby="Heading-{{ section.id }}" {{ section.shopify_attributes }}>
    <div class="wrap grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        {%- if s.eyebrow != blank -%}<p class="label text-granite">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 id="Heading-{{ section.id }}" class="display mt-4 text-6xl sm:text-8xl">{{ s.heading }} <span class="text-bloom">{{ s.heading_accent }}</span></h2>
        {%- if s.text != blank -%}<p class="mt-5 max-w-sm text-[16px] leading-relaxed text-ink/75">{{ s.text }}</p>{%- endif -%}
      </div>
      <div class="lg:col-span-8">
        <ps-fit>
          <script type="application/json">{"trail": {{ trail_url | json }}, "tunnel": {{ tunnel_url | json }}, "products": [{{ products_json }}]}</script>
        </ps-fit>
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="wrap py-16" {{ section.shopify_attributes }}>
    <p class="form-message text-granite">The fit finder needs at least two products tagged with warmth:cold or warmth:warm and fit:oversized, fit:boxy, fit:cropped or fit:classic (plus place:trail or place:tunnel).</p>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Fit finder quiz",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fit finder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trail or" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (pink)", "default": "tunnel?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Three taps and we'll point you to the piece that fits your day, your weather and the way you like to wear it." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to use all products." },
    { "type": "image_picker", "id": "trail_image", "label": "Trail answer image" },
    { "type": "image_picker", "id": "tunnel_image", "label": "Tunnel answer image" }
  ],
  "presets": [{ "name": "Fit finder quiz" }]
}
{% endschema %}

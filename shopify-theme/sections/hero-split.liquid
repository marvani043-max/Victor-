{%- liquid
  assign s = section.settings
-%}
<section class="hero relative -mt-[var(--header-h)] min-h-[600px] overflow-hidden bg-ink text-bone" aria-label="{{ shop.name }}" {{ section.shopify_attributes }}>
  {%- if s.video != blank -%}
    <div class="absolute inset-0">
      {{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, class: 'absolute inset-0 h-full w-full object-cover', image_size: '1800x' }}
    </div>
  {%- else -%}
    <div class="absolute inset-0 flex">
      <div class="hero-panel hp-1 relative h-full overflow-hidden">
        <div class="hero-img absolute inset-0">
          {%- render 'image', image: s.image_1, fallback: s.fallback_1, alt: s.alt_1, class: 'h-full w-full object-cover', sizes: '(min-width: 1024px) 70vw, 50vw', loading: 'eager', style: s.position_1 -%}
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-ink/40"></div>
        {%- if s.label_1 != blank -%}<p class="label absolute text-bone/80" style="left: 1rem; top: calc(var(--header-h) + 1.25rem)">{{ s.label_1 }}</p>{%- endif -%}
      </div>
      <div class="hero-panel hp-2 relative h-full overflow-hidden">
        <div class="hero-img absolute inset-0">
          {%- render 'image', image: s.image_2, fallback: s.fallback_2, alt: s.alt_2, class: 'h-full w-full object-cover', sizes: '(min-width: 1024px) 70vw, 50vw', loading: 'eager', style: s.position_2 -%}
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-ink/40"></div>
        {%- if s.label_2 != blank -%}<p class="label absolute text-bone/80" style="right: 1rem; top: calc(var(--header-h) + 1.25rem)">{{ s.label_2 }}</p>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="grain pointer-events-none absolute inset-0"></div>

  <div class="wrap pointer-events-none relative flex h-full flex-col justify-end pb-10 sm:pb-14">
    <h1 class="display text-[19vw] sm:text-[15vw] lg:text-[11.5vw] 2xl:text-[10rem]">
      <span class="block overflow-hidden pb-[0.04em]"><span class="hero-line block" style="--d: 0.55s">{{ s.heading_1 }}</span></span>
      <span class="block overflow-hidden pb-[0.04em]"><span class="hero-line block" style="--d: 0.67s">{{ s.heading_2 }} <span class="text-sakura">{{ s.heading_accent }}</span></span></span>
    </h1>
    <div class="hero-sub pointer-events-auto mt-5 flex flex-col gap-5 sm:mt-8 sm:gap-6 lg:flex-row lg:items-end lg:justify-between">
      {%- if s.text != blank -%}<p class="max-w-md text-[15px] leading-relaxed text-bone/85 sm:text-[17px]">{{ s.text }}</p>{%- endif -%}
      <div class="flex flex-wrap gap-3">
        {%- if s.button_1_label != blank -%}
          {%- capture b1 -%}{%- render 'safe-link', url: s.button_1_link, fallback: routes.all_products_collection_url -%}{%- endcapture -%}
          <a href="{{ b1 | default: routes.all_products_collection_url }}" class="btn-bone px-5 sm:px-6">{{ s.button_1_label }} {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
        {%- capture b2 -%}{%- render 'safe-link', url: s.button_2_link, fallback: '' -%}{%- endcapture -%}
        {%- if s.button_2_label != blank and b2 != blank -%}
          <a href="{{ b2 }}" class="btn border border-bone/50 px-5 text-bone hover:border-bone hover:bg-bone hover:text-ink sm:px-6">{{ s.button_2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero: trail / tunnel",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Left panel" },
    { "type": "image_picker", "id": "image_1", "label": "Image" },
    { "type": "select", "id": "fallback_1", "label": "Bundled photo (used when no image is set)", "default": "trail-falls-front", "options": [{ "value": "", "label": "None" }, { "value": "trail-falls-front", "label": "Trail: waterfall, black tee" }, { "value": "trail-falls-back", "label": "Trail: waterfall, tee back" }, { "value": "trail-falls-wide", "label": "Trail: waterfall, wide" }, { "value": "trail-falls-rock", "label": "Trail: granite and falls" }, { "value": "trail-falls-duo", "label": "Trail: two at the falls" }, { "value": "trail-overlook", "label": "Trail: canyon overlook" }, { "value": "trail-ridge", "label": "Trail: boulder" }, { "value": "trail-path", "label": "Trail: forest path" }, { "value": "tunnel-crew", "label": "Tunnel: the crew" }, { "value": "tunnel-pink-hoodie", "label": "Tunnel: pink hoodie" }, { "value": "tunnel-crop-duo-2", "label": "Tunnel: crop top duo" }, { "value": "tunnel-crop-sit", "label": "Tunnel: sitting crew" }, { "value": "tunnel-crop-white", "label": "Tunnel: white crop top" }, { "value": "tunnel-crop-white-2", "label": "Tunnel: white crop top 2" }, { "value": "tunnel-zip-black", "label": "Tunnel: black zip hoodie" }, { "value": "tunnel-zip-navy", "label": "Tunnel: navy zip hoodie" }, { "value": "tunnel-tee-black-back", "label": "Tunnel: tee back print" }, { "value": "night-boxy-trio", "label": "Night: boxy tee trio" }, { "value": "detail-graphic-black", "label": "Detail: Summer Edition graphic" }] },
    { "type": "text", "id": "alt_1", "label": "Image description (alt text)", "default": "Wearing the black Summer Edition tee in front of a mountain waterfall" },
    { "type": "text", "id": "label_1", "label": "Label", "default": "01 — Trail" },
    { "type": "text", "id": "position_1", "label": "Image focus (CSS)", "default": "object-position: 28% 40%" },
    { "type": "header", "content": "Right panel" },
    { "type": "image_picker", "id": "image_2", "label": "Image" },
    { "type": "select", "id": "fallback_2", "label": "Bundled photo (used when no image is set)", "default": "tunnel-pink-hoodie", "options": [{ "value": "", "label": "None" }, { "value": "trail-falls-front", "label": "Trail: waterfall, black tee" }, { "value": "trail-falls-back", "label": "Trail: waterfall, tee back" }, { "value": "trail-falls-wide", "label": "Trail: waterfall, wide" }, { "value": "trail-falls-rock", "label": "Trail: granite and falls" }, { "value": "trail-falls-duo", "label": "Trail: two at the falls" }, { "value": "trail-overlook", "label": "Trail: canyon overlook" }, { "value": "trail-ridge", "label": "Trail: boulder" }, { "value": "trail-path", "label": "Trail: forest path" }, { "value": "tunnel-crew", "label": "Tunnel: the crew" }, { "value": "tunnel-pink-hoodie", "label": "Tunnel: pink hoodie" }, { "value": "tunnel-crop-duo-2", "label": "Tunnel: crop top duo" }, { "value": "tunnel-crop-sit", "label": "Tunnel: sitting crew" }, { "value": "tunnel-crop-white", "label": "Tunnel: white crop top" }, { "value": "tunnel-crop-white-2", "label": "Tunnel: white crop top 2" }, { "value": "tunnel-zip-black", "label": "Tunnel: black zip hoodie" }, { "value": "tunnel-zip-navy", "label": "Tunnel: navy zip hoodie" }, { "value": "tunnel-tee-black-back", "label": "Tunnel: tee back print" }, { "value": "night-boxy-trio", "label": "Night: boxy tee trio" }, { "value": "detail-graphic-black", "label": "Detail: Summer Edition graphic" }] },
    { "type": "text", "id": "alt_2", "label": "Image description (alt text)", "default": "Two friends in Peak Side hoodies against a graffiti wall" },
    { "type": "text", "id": "label_2", "label": "Label", "default": "02 — Tunnel" },
    { "type": "text", "id": "position_2", "label": "Image focus (CSS)", "default": "object-position: 62% 30%" },
    { "type": "header", "content": "Video (optional)" },
    { "type": "video", "id": "video", "label": "Background video", "info": "Replaces both panels. Plays muted and looped." },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading_1", "label": "Heading line 1", "default": "Mountains" },
    { "type": "text", "id": "heading_2", "label": "Heading line 2", "default": "meet" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (pink)", "default": "everyday." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Heavyweight hoodies, Summer Edition tees and crop tops for days that start on a trail and end in town." },
    { "type": "text", "id": "button_1_label", "label": "First button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_1_link", "label": "First button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "Our story" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero: trail / tunnel" }]
}
{% endschema %}

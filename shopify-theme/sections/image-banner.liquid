{%- assign s = section.settings -%}
<section class="relative min-h-[520px] overflow-hidden bg-ink text-bone" style="height: {{ s.height }}vh" {{ section.shopify_attributes }}>
  {%- render 'image', image: s.image, fallback: s.fallback, alt: s.alt, class: 'absolute inset-0 h-full w-full object-cover', loading: 'eager', style: s.position -%}
  <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/20 to-ink/30"></div>
  <div class="wrap relative flex h-full flex-col justify-end pb-12">
    {%- if s.eyebrow != blank -%}<p class="label text-bone/75">{{ s.eyebrow }}</p>{%- endif -%}
    <h1 class="display mt-4 text-[18vw] sm:text-[9rem] lg:text-[11rem]">{{ s.heading }}<br><span class="text-sakura">{{ s.heading_accent }}</span></h1>
  </div>
</section>

{% schema %}
{
  "name": "Image banner",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "fallback", "label": "Bundled photo (used when no image is set)", "default": "trail-falls-rock", "options": [{"value":"","label":"None"},{"value":"trail-falls-front","label":"Trail: waterfall, black tee"},{"value":"trail-falls-back","label":"Trail: waterfall, tee back"},{"value":"trail-falls-wide","label":"Trail: waterfall, wide"},{"value":"trail-falls-rock","label":"Trail: granite and falls"},{"value":"trail-falls-duo","label":"Trail: two at the falls"},{"value":"trail-overlook","label":"Trail: canyon overlook"},{"value":"trail-ridge","label":"Trail: boulder"},{"value":"trail-path","label":"Trail: forest path"},{"value":"tunnel-crew","label":"Tunnel: the crew"},{"value":"tunnel-pink-hoodie","label":"Tunnel: pink hoodie"},{"value":"tunnel-crop-duo-2","label":"Tunnel: crop top duo"},{"value":"tunnel-crop-sit","label":"Tunnel: sitting crew"},{"value":"tunnel-crop-white","label":"Tunnel: white crop top"},{"value":"tunnel-crop-white-2","label":"Tunnel: white crop top 2"},{"value":"tunnel-zip-black","label":"Tunnel: black zip hoodie"},{"value":"tunnel-zip-navy","label":"Tunnel: navy zip hoodie"},{"value":"tunnel-tee-black-back","label":"Tunnel: tee back print"},{"value":"night-boxy-trio","label":"Night: boxy tee trio"},{"value":"detail-graphic-black","label":"Detail: Summer Edition graphic"}] },
    { "type": "text", "id": "alt", "label": "Image description (alt text)", "default": "Standing on granite at the foot of a waterfall in a Peak Side tee" },
    { "type": "text", "id": "position", "label": "Image focus (CSS)", "default": "object-position: 50% 72%" },
    { "type": "range", "id": "height", "label": "Height", "min": 50, "max": 100, "step": 2, "unit": "vh", "default": 78 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Started at 16." },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (pink)", "default": "Built outside." }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}

<footer class="relative overflow-hidden bg-ink text-bone" {{ section.shopify_attributes }}>
  <div class="wrap pb-8 pt-20 sm:pt-28">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="label text-mist">{{ settings.brand_descriptor }}</p>
        <p class="display mt-4 text-[15vw] leading-[0.82] sm:text-8xl lg:text-[7.5rem]">
          {{ section.settings.heading_1 }}<br>
          {{ section.settings.heading_2 }} <span class="text-sakura">{{ section.settings.heading_accent }}</span>
        </p>

        {%- if section.settings.show_newsletter -%}
          <div class="mt-10 max-w-md">
            <p class="text-[15px] leading-relaxed text-bone/75">{{ section.settings.newsletter_text }}</p>
            {%- form 'customer', id: 'FooterNewsletter', class: 'mt-4' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="form-message text-bone" role="status">{{ 'newsletter.success' | t }}</p>
              {%- else -%}
                <div class="flex flex-col gap-3 sm:flex-row">
                  <label for="FooterNewsletterEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
                  <input id="FooterNewsletterEmail" type="email" name="contact[email]" class="field field-dark min-w-0 flex-1" placeholder="{{ 'newsletter.label' | t }}" autocomplete="email" required>
                  <button type="submit" class="btn-bone shrink-0">{{ 'newsletter.button' | t }}</button>
                </div>
                {%- if form.errors -%}
                  <p class="form-message mt-3 text-bone" role="alert">{{ form.errors | default_errors }}</p>
                {%- endif -%}
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}

        <div class="mt-8 flex flex-wrap gap-3">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" class="btn border border-bone/40 hover:bg-bone hover:text-ink">
              {% render 'icon', name: 'instagram', class: 'h-4 w-4' %} {{ settings.social_instagram_handle | default: 'Instagram' }}
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener noreferrer" class="btn border border-bone/40 hover:bg-bone hover:text-ink">
              {% render 'icon', name: 'tiktok', class: 'h-4 w-4' %} TikTok
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:col-span-6 lg:col-start-7 lg:pt-4">
        {%- for block in section.blocks -%}
          {%- assign links = block.settings.menu.links -%}
          <div {{ block.shopify_attributes }}>
            <h2 class="label text-mist">{{ block.settings.heading | default: block.settings.menu.title }}</h2>
            {%- if links.size > 0 -%}
              <ul class="mt-5 space-y-3">
                {%- for link in links -%}
                  <li><a href="{{ link.url }}" class="link-u text-[15px]">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endfor -%}
        {%- if section.blocks.size == 0 -%}
          <div>
            <h2 class="label text-mist">Help</h2>
            <ul class="mt-5 space-y-3">
              {%- if shop.shipping_policy -%}<li><a href="{{ shop.shipping_policy.url }}" class="link-u text-[15px]">{{ shop.shipping_policy.title }}</a></li>{%- endif -%}
              {%- if shop.refund_policy -%}<li><a href="{{ shop.refund_policy.url }}" class="link-u text-[15px]">{{ shop.refund_policy.title }}</a></li>{%- endif -%}
              {%- if shop.privacy_policy -%}<li><a href="{{ shop.privacy_policy.url }}" class="link-u text-[15px]">{{ shop.privacy_policy.title }}</a></li>{%- endif -%}
              {%- if shop.terms_of_service -%}<li><a href="{{ shop.terms_of_service.url }}" class="link-u text-[15px]">{{ shop.terms_of_service.title }}</a></li>{%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="mt-20 flex flex-col gap-4 border-t border-bone/15 pt-6 text-mist sm:flex-row sm:items-center sm:justify-between">
      <p class="label">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="flex flex-wrap items-center gap-2" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'h-6 w-auto' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if settings.contact_email != blank -%}
        <a href="mailto:{{ settings.contact_email }}" class="label link-u">{{ settings.contact_email }}</a>
      {%- endif -%}
    </div>
  </div>
  <span aria-hidden="true" class="mask-pks pointer-events-none absolute -right-16 bottom-10 hidden h-64 w-80 text-bone/[0.04] lg:block"></span>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "settings": [
    { "type": "text", "id": "heading_1", "label": "Heading line 1", "default": "Mountains" },
    { "type": "text", "id": "heading_2", "label": "Heading line 2", "default": "meet" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (pink)", "default": "everyday." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true },
    { "type": "text", "id": "newsletter_text", "label": "Email signup text", "default": "Drops, restocks and the odd trail report. No spam." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}

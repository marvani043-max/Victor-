{%- assign s = section.settings -%}
<section id="faq" class="wrap scroll-mt-28 py-20 sm:py-28" aria-labelledby="Heading-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 id="Heading-{{ section.id }}" class="display text-6xl sm:text-8xl">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="mt-4 max-w-xs text-[15px] leading-relaxed text-ink/70">{{ s.text }}</p>{%- endif -%}
      {%- if settings.contact_email != blank -%}
        <a href="mailto:{{ settings.contact_email }}" class="btn-ink mt-6">{{ s.button_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="border-t border-ink/15 lg:col-span-8">
      {%- for block in section.blocks -%}
        <details class="group border-b border-ink/15" {{ block.shopify_attributes }}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 [&::-webkit-details-marker]:hidden">
            <span class="label text-[12px]">{{ block.settings.question }}</span>
            {%- render 'icon', name: 'plus', class: 'h-3 w-3 shrink-0 transition-transform duration-300 group-open:rotate-45' -%}
          </summary>
          <div class="rte pb-5 text-[15px] leading-relaxed text-ink/80">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Can't find your answer? Email us and we'll get back to you." },
    { "type": "text", "id": "button_label", "label": "Email button label", "default": "Email Peak Side" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long until my order ships?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders are typically processed within 2–5 business days.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How long until my order ships?", "answer": "<p>Orders are typically processed within 2–5 business days. Once your order ships you'll get an email with tracking.</p>" } },
        { "type": "question", "settings": { "question": "Can I return or exchange something?", "answer": "<p>Yes, within 30 days of delivery. Items need to be unworn, unwashed, in original condition and with the original tags attached.</p>" } }
      ]
    }
  ]
}
{% endschema %}

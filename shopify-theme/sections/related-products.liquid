{%- comment -%}
  Shopify product recommendations, loaded after the page by theme.js
  (fetches this section from routes.product_recommendations_url).
{%- endcomment -%}
<section class="border-t border-ink/10 py-20" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related" {{ section.shopify_attributes }}>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="wrap">
      <h2 class="display text-5xl sm:text-7xl">{{ section.settings.heading }}</h2>
      <ul class="mt-8 grid grid-cols-2 gap-x-3 gap-y-10 sm:gap-x-5 lg:grid-cols-4">
        {%- for product in recommendations.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Related products",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wear it with" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}

<div class="wrap pb-28 pt-10 sm:pt-16" {{ section.shopify_attributes }}>
  <h1 class="display text-[17vw] sm:text-[8rem] lg:text-[10rem]">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="mt-10 grid gap-12 lg:grid-cols-12" novalidate data-cart-form>
      <div class="lg:col-span-8">
        <ul class="border-t border-ink/15">
          {%- for item in cart.items -%}
            <li class="grid grid-cols-[96px_1fr] gap-4 border-b border-ink/15 py-5 sm:grid-cols-[120px_1fr_auto] sm:gap-6">
              <a href="{{ item.url }}" class="relative block aspect-[4/5] overflow-hidden bg-white">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 360 | image_tag: widths: '120, 240, 360', sizes: '120px', class: 'absolute inset-0 h-full w-full object-cover', alt: item.title, loading: 'lazy' }}
                {%- endif -%}
              </a>
              <div class="min-w-0">
                <a href="{{ item.url }}" class="text-[15px] font-medium leading-snug hover:underline">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="label mt-2 text-granite">{{ item.variant.title }}</p>
                {%- endunless -%}
                {%- for property in item.properties -%}
                  {%- unless property.last == blank or property.first contains '_' -%}
                    <p class="mt-1 text-[13px] text-granite">{{ property.first }}: {{ property.last }}</p>
                  {%- endunless -%}
                {%- endfor -%}
                {%- if item.selling_plan_allocation -%}<p class="mt-1 text-[13px] text-granite">{{ item.selling_plan_allocation.selling_plan.name }}</p>{%- endif -%}
                <div class="mt-4 flex flex-wrap items-center gap-4">
                  <div class="qty">
                    <button type="button" data-qty="-1" aria-label="{{ 'products.product.decrease' | t }}">&minus;</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="{{ 'cart.quantity' | t }}: {{ item.product.title | escape }}" data-cart-qty>
                    <button type="button" data-qty="1" aria-label="{{ 'products.product.increase' | t }}">+</button>
                  </div>
                  <a href="{{ item.url_to_remove }}" class="label link-u text-granite">{{ 'cart.remove' | t }}</a>
                </div>
              </div>
              <p class="col-start-2 font-mono text-[14px] sm:col-start-auto sm:text-right">
                {%- if item.original_line_price != item.final_line_price -%}
                  <span class="block text-granite line-through">{{ item.original_line_price | money }}</span>
                {%- endif -%}
                {{ item.final_line_price | money }}
              </p>
            </li>
          {%- endfor -%}
        </ul>
        <button type="submit" name="update" class="label link-u mt-4 inline-block py-3 text-granite" data-cart-update>{{ 'cart.update' | t }}</button>
      </div>

      <aside class="lg:col-span-4">
        <div class="bg-stone p-6 lg:sticky" style="top: calc(var(--header-h) + 2rem)">
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="mb-4 space-y-1 text-[14px]">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li class="flex justify-between"><span>{{ discount.title }}</span><span>-{{ discount.total_allocated_amount | money }}</span></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="flex items-baseline justify-between">
            <p class="label">{{ 'cart.subtotal' | t }}</p>
            <p class="font-mono text-xl">{{ cart.total_price | money_with_currency }}</p>
          </div>
          <p class="mt-2 text-[13px] text-granite">{{ 'cart.taxes' | t }}</p>
          {%- if section.settings.show_note -%}
            <label for="CartNote" class="label mt-6 block">{{ 'cart.note' | t }}</label>
            <textarea id="CartNote" name="note" class="field mt-2 min-h-[90px]">{{ cart.note }}</textarea>
          {%- endif -%}
          <button type="submit" name="checkout" class="btn-ink mt-6 w-full py-5">{{ 'cart.checkout' | t }} {% render 'icon', name: 'arrow' %}</button>
          {%- if additional_checkout_buttons -%}
            <div class="mt-3">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </aside>
    </form>
  {%- else -%}
    <div class="py-16">
      <p class="text-[18px] text-ink/75">{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn-ink mt-6">{{ 'cart.continue' | t }} {% render 'icon', name: 'arrow' %}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": false }
  ]
}
{% endschema %}

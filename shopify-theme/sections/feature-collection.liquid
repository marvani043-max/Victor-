{%- liquid
  assign s = section.settings
-%}
<section class="relative overflow-hidden py-24 sm:py-32" style="background: {{ s.background }}" aria-labelledby="Heading-{{ section.id }}" {{ section.shopify_attributes }}>
  {%- if s.effect == 'petals' -%}<ps-petals></ps-petals>{%- elsif s.effect == 'snow' -%}<ps-petals snow></ps-petals>{%- endif -%}
  <div class="wrap relative grid items-center gap-12 lg:grid-cols-12">
    <div class="relative lg:col-span-6" data-reveal>
      <div class="relative aspect-[4/5] overflow-hidden bg-coal">
        {%- render 'image', image: s.image, fallback: s.fallback, alt: s.alt, class: 'h-full w-full object-cover', sizes: '(min-width: 1024px) 50vw, 100vw' -%}
      </div>
    </div>
    <div class="lg:col-span-5 lg:col-start-8" data-reveal style="--delay: 0.1s">
      {%- if s.eyebrow != blank -%}<p class="label text-granite">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 id="Heading-{{ section.id }}" class="display mt-4 text-7xl sm:text-8xl lg:text-[7.5rem]">
        {{ s.heading }} <span class="text-bloom">{{ s.heading_accent }}</span>
      </h2>
      {%- if s.text != blank -%}<div class="rte mt-6 max-w-md text-[17px] leading-relaxed text-ink/80">{{ s.text }}</div>{%- endif -%}
      {%- if s.hint != blank and s.effect != 'none' -%}<p class="label mt-5 text-bloom">{{ s.hint }}</p>{%- endif -%}

      {%- capture cards -%}
        {%- render 'collection-products', collection: s.collection, tag: s.fallback_tag, keyword: s.fallback_keyword, limit: s.products_to_show, fill: false, li_class: '', reveal: false, show_best_seller: false, sizes: '(min-width: 1024px) 20vw, 50vw' -%}
      {%- endcapture -%}
      {%- if cards != blank -%}
        <ul class="mt-8 grid grid-cols-2 gap-3">{{ cards }}</ul>
      {%- elsif request.design_mode -%}
        <p class="form-message mt-8 text-granite">Choose a collection in this section's settings to show products here.</p>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        {%- capture btn_link -%}{%- render 'safe-link', url: s.button_link, fallback: '' -%}{%- endcapture -%}
        <a href="{{ btn_link | default: s.collection.url | default: routes.all_products_collection_url }}" class="btn-ink mt-8">{{ s.button_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "fallback", "label": "Bundled photo (used when no image is set)", "default": "detail-graphic-black", "options": [{"value":"","label":"None"},{"value":"trail-falls-front","label":"Trail: waterfall, black tee"},{"value":"trail-falls-back","label":"Trail: waterfall, tee back"},{"value":"trail-falls-wide","label":"Trail: waterfall, wide"},{"value":"trail-falls-rock","label":"Trail: granite and falls"},{"value":"trail-falls-duo","label":"Trail: two at the falls"},{"value":"trail-overlook","label":"Trail: canyon overlook"},{"value":"trail-ridge","label":"Trail: boulder"},{"value":"trail-path","label":"Trail: forest path"},{"value":"tunnel-crew","label":"Tunnel: the crew"},{"value":"tunnel-pink-hoodie","label":"Tunnel: pink hoodie"},{"value":"tunnel-crop-duo-2","label":"Tunnel: crop top duo"},{"value":"tunnel-crop-sit","label":"Tunnel: sitting crew"},{"value":"tunnel-crop-white","label":"Tunnel: white crop top"},{"value":"tunnel-crop-white-2","label":"Tunnel: white crop top 2"},{"value":"tunnel-zip-black","label":"Tunnel: black zip hoodie"},{"value":"tunnel-zip-navy","label":"Tunnel: navy zip hoodie"},{"value":"tunnel-tee-black-back","label":"Tunnel: tee back print"},{"value":"night-boxy-trio","label":"Night: boxy tee trio"},{"value":"detail-graphic-black","label":"Detail: Summer Edition graphic"}] },
    { "type": "text", "id": "alt", "label": "Image description (alt text)", "default": "Close-up of the cherry-blossom Peak Side graphic on a faded black tee" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The graphic" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Summer" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (pink)", "default": "Edition" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Cherry-blossom branches wrapped around the Peak Side oval: small on the chest, full-size across the back. It runs across tees in black and white, regular and boxy, plus the washed crop top.</p>" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 0, "max": 4, "step": 2, "default": 2 },
    { "type": "text", "id": "fallback_tag", "label": "Without a collection, use products tagged", "default": "summer-edition" },
    { "type": "text", "id": "fallback_keyword", "label": "…or products whose title contains", "default": "summer edition" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Summer Edition" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the collection." },
    { "type": "select", "id": "effect", "label": "Falling effect", "default": "petals", "options": [{ "value": "petals", "label": "Cherry-blossom petals" }, { "value": "snow", "label": "Snow" }, { "value": "none", "label": "None" }] },
    { "type": "text", "id": "hint", "label": "Effect hint", "default": "Move your cursor or tap to shake the blossom" },
    { "type": "color", "id": "background", "label": "Background", "default": "#F6EEF0" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}

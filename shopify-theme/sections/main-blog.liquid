<div class="wrap pb-28 pt-10 sm:pt-16" {{ section.shopify_attributes }}>
  <h1 class="display text-[17vw] sm:text-[8rem] lg:text-[10rem]">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <ul class="mt-10 grid gap-x-5 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {%- for article in blog.articles -%}
        <li>
          <a href="{{ article.url }}" class="group block">
            <div class="relative aspect-[4/3] overflow-hidden bg-stone">
              {%- if article.image -%}
                {{ article.image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw', class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105', alt: article.title, loading: 'lazy' }}
              {%- endif -%}
            </div>
            <p class="label mt-4 text-granite">{{ article.published_at | date: format: 'date' }}</p>
            <h2 class="mt-2 text-[20px] font-semibold leading-snug">{{ article.title }}</h2>
            {%- if article.excerpt_or_content != blank -%}
              <p class="mt-2 text-[15px] leading-relaxed text-ink/70">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}{%- render 'pagination', paginate: paginate -%}{%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog posts", "tag": "section" }
{% endschema %}

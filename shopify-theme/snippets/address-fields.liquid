{%- comment -%} Address form fields. Params: form, id {%- endcomment -%}
<div class="grid gap-3 sm:grid-cols-2">
  <div><label for="AddrFirst-{{ id }}" class="label">{{ 'customer.register.first_name' | t }}</label><input id="AddrFirst-{{ id }}" type="text" name="address[first_name]" value="{{ form.first_name }}" class="field mt-2" autocomplete="given-name"></div>
  <div><label for="AddrLast-{{ id }}" class="label">{{ 'customer.register.last_name' | t }}</label><input id="AddrLast-{{ id }}" type="text" name="address[last_name]" value="{{ form.last_name }}" class="field mt-2" autocomplete="family-name"></div>
</div>
<div><label for="AddrCompany-{{ id }}" class="label">{{ 'customer.addresses.company' | t }}</label><input id="AddrCompany-{{ id }}" type="text" name="address[company]" value="{{ form.company }}" class="field mt-2" autocomplete="organization"></div>
<div><label for="AddrA1-{{ id }}" class="label">{{ 'customer.addresses.address1' | t }}</label><input id="AddrA1-{{ id }}" type="text" name="address[address1]" value="{{ form.address1 }}" class="field mt-2" autocomplete="address-line1"></div>
<div><label for="AddrA2-{{ id }}" class="label">{{ 'customer.addresses.address2' | t }}</label><input id="AddrA2-{{ id }}" type="text" name="address[address2]" value="{{ form.address2 }}" class="field mt-2" autocomplete="address-line2"></div>
<div class="grid gap-3 sm:grid-cols-2">
  <div><label for="AddrCity-{{ id }}" class="label">{{ 'customer.addresses.city' | t }}</label><input id="AddrCity-{{ id }}" type="text" name="address[city]" value="{{ form.city }}" class="field mt-2" autocomplete="address-level2"></div>
  <div><label for="AddrZip-{{ id }}" class="label">{{ 'customer.addresses.zip' | t }}</label><input id="AddrZip-{{ id }}" type="text" name="address[zip]" value="{{ form.zip }}" class="field mt-2" autocomplete="postal-code" autocapitalize="characters"></div>
</div>
<div class="grid gap-3 sm:grid-cols-2">
  <div>
    <label for="AddrCountry-{{ id }}" class="label">{{ 'customer.addresses.country' | t }}</label>
    <select id="AddrCountry-{{ id }}" name="address[country]" class="field mt-2" autocomplete="country">{{ all_country_option_tags }}</select>
  </div>
  <div><label for="AddrProvince-{{ id }}" class="label">{{ 'customer.addresses.province' | t }}</label><input id="AddrProvince-{{ id }}" type="text" name="address[province]" value="{{ form.province }}" class="field mt-2" autocomplete="address-level1"></div>
</div>
<div><label for="AddrPhone-{{ id }}" class="label">{{ 'customer.addresses.phone' | t }}</label><input id="AddrPhone-{{ id }}" type="tel" name="address[phone]" value="{{ form.phone }}" class="field mt-2" autocomplete="tel"></div>
<label class="flex items-center gap-2 text-[14px]"><input type="checkbox" name="address[default]" value="1" class="h-4 w-4 accent-ink"{% if form.set_as_default_checkbox %} checked{% endif %}> {{ 'customer.addresses.set_default' | t }}</label>

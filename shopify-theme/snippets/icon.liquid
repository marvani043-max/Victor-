{%- comment -%}
  Inline SVG icons. Usage: {% render 'icon', name: 'arrow', class: 'h-3.5 w-3.5' %}
{%- endcomment -%}
{%- assign c = class | default: 'h-3.5 w-3.5' -%}
{%- case name -%}
  {%- when 'arrow' -%}
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false" class="{{ c }}"><path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg>
  {%- when 'arrow-left' -%}
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false" class="{{ c }}"><path d="M15 8H2M7 3L2 8l5 5" stroke="currentColor" stroke-width="1.5"/></svg>
  {%- when 'arrow-up-right' -%}
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false" class="{{ c }}"><path d="M4 12L12 4M5 4h7v7" stroke="currentColor" stroke-width="1.5"/></svg>
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" class="{{ c }}"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" class="{{ c }}"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5" stroke="currentColor" stroke-width="1.6"/><path d="M14 3c.4 2.6 2.2 4.4 5 4.7" stroke="currentColor" stroke-width="1.6"/></svg>
  {%- when 'plus' -%}
    <svg viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false" class="{{ c }}"><path d="M6 0v12M0 6h12" stroke="currentColor" stroke-width="1.4"/></svg>
  {%- when 'minus' -%}
    <svg viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false" class="{{ c }}"><path d="M0 6h12" stroke="currentColor" stroke-width="1.4"/></svg>
  {%- when 'bag' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" class="{{ c }}"><path d="M5 8h14l-1 12H6L5 8z" stroke="currentColor" stroke-width="1.5"/><path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.5"/></svg>
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" class="{{ c }}"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.5"/><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.5"/></svg>
  {%- when 'account' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false" class="{{ c }}"><circle cx="12" cy="8.5" r="3.5" stroke="currentColor" stroke-width="1.5"/><path d="M5 20c1.2-3.5 4-5 7-5s5.8 1.5 7 5" stroke="currentColor" stroke-width="1.5"/></svg>
  {%- when 'close' -%}
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false" class="{{ c }}"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5"/></svg>
  {%- when 'ridge' -%}
    <svg viewBox="0 0 96 12" fill="none" aria-hidden="true" focusable="false" class="{{ c }}" preserveAspectRatio="none"><path d="M0 11 L18 6 L27 9 L44 1 L58 8 L66 5 L80 10 L96 7" stroke="currentColor" stroke-width="1.25" vector-effect="non-scaling-stroke"/></svg>
{%- endcase -%}
